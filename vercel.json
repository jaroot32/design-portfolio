{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/rise-course", "destination": "/rise-course/index.html" },
    { "source": "/rise-course/goodbye", "destination": "/rise-course/goodbye.html" },
    { "source": "/rise-course/lib/sandbox/sandbox", "destination": "/rise-course/lib/sandbox/sandbox.html" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
