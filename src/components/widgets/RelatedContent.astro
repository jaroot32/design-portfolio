---
interface RelatedItem {
  title: string;
  description: string;
  href: string;
  tagline?: string;
}

interface Props {
  items: RelatedItem[];
  heading?: string;
}

const { items, heading = 'Related Case Studies' } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
  <div class="mb-8 text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-accent mb-2">Keep Exploring</p>
    <h2 class="text-2xl md:text-3xl font-bold font-heading tracking-tighter">{heading}</h2>
  </div>
  <div
    class={`grid gap-4 ${items.length === 1 ? 'max-w-xl mx-auto' : items.length === 2 ? 'sm:grid-cols-2 max-w-3xl mx-auto' : 'sm:grid-cols-2 lg:grid-cols-3'}`}
  >
    {
      items.map((item) => (
        <a
          href={item.href}
          class="group relative flex flex-col p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent dark:hover:border-accent transition-all duration-200 shadow-sm hover:shadow-lg"
        >
          {item.tagline && <p class="text-xs font-bold uppercase tracking-widest text-accent mb-2">{item.tagline}</p>}
          <h3 class="text-base font-bold font-heading leading-snug mb-2 group-hover:text-accent transition-colors duration-200">
            {item.title}
          </h3>
          <p class="text-sm text-muted leading-relaxed flex-1">{item.description}</p>
          <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
            View case study
            <svg
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>
