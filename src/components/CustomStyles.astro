    background-image: url("data:image/svg+xml,%3Csvg width='54' height='54' viewBox='0 0 54 54' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M36 10a6 6 0 0 1 12 0v2a2 2 0 0 0 2 2h3a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-3a2 2 0 0 0-2 2 6 6 0 0 1-12 0 2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2 6 6 0 0 1-12 0 2 2 0 0 0-2-2H3a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h3a2 2 0 0 0 2-2 6 6 0 0 1 12 0 2 2 0 0 0 2 2h6a2 2 0 0 0 2-2zm-6 38a6 6 0 0 1-12 0 2 2 0 0 0-2-2H3a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h13a2 2 0 0 0 2-2 6 6 0 0 1 12 0 2 2 0 0 0 2 2h13a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H38a2 2 0 0 0-2 2zM12 36a2 2 0 0 0-2-2H3a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h7a2 2 0 0 0 2-2 6 6 0 0 1 12 0 2 2 0 0 0 2 2h6a2 2 0 0 0 2-2 6 6 0 0 1 12 0 2 2 0 0 0 2 2h7a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-7a2 2 0 0 0-2 2 6 6 0 0 1-12 0 2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2 6 6 0 0 1-12 0z' fill='%239C92AC' fill-opacity='0.06' fill-rule='evenodd'/%3E%3C/svg%3E");
