---
interface Props {
  paragraphs: string[];
  name: string;
  title: string;
  context?: string;
  url?: string;
}
const { paragraphs = [], name, title, context, url } = Astro.props;
---

<section class="max-w-4xl mx-auto px-4 md:px-8 py-12">
  <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 md:p-8 shadow-sm">
    <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-4">
      Recommendation
    </p>
    <div class="space-y-4 text-base md:text-lg text-gray-800 dark:text-gray-200 leading-relaxed">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <p class="mt-6 text-sm text-muted">
      <span class="font-semibold text-gray-900 dark:text-white">
        {url ? (
          <a href={url} class="hover:text-accent underline-offset-2 hover:underline" rel="noopener" target="_blank">
            {name}
          </a>
        ) : (
          name
        )}
      </span>
      <br />
      {title}
      {context && (<><br /><span class="text-xs">{context}</span></>)}
    </p>
  </div>
</section>
