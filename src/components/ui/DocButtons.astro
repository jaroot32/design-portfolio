---
interface Doc {
  label: string;
  href: string;
}
interface Props {
  docs: Doc[];
  title?: string;
}
const { docs = [], title = 'Design deliverables' } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 md:px-8 pb-6">
  <div class="flex flex-wrap items-center gap-3">
    <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-blue-200 mr-2">{title}</p>
    {
      docs.map((d) => (
        <a
          href={d.href}
          download
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border-2 border-purple-200 dark:border-purple-700 bg-white dark:bg-gray-900 text-sm font-semibold text-gray-800 dark:text-gray-200 hover:border-purple-500 hover:text-purple-700 dark:hover:text-purple-300 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
          </svg>
          {d.label}
          <span class="text-xs font-medium text-muted">.docx</span>
        </a>
      ))
    }
  </div>
</section>
