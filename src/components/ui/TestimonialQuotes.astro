---
interface Quote {
  quote: string;
  name: string;
  title: string;
  context?: string;
  url?: string;
}
interface Props {
  items: Quote[];
  heading?: string;
  eyebrow?: string;
}
const { items = [], heading = 'What colleagues say', eyebrow = 'Recommendations' } = Astro.props;
---

<section class="max-w-6xl mx-auto px-4 md:px-8 py-10">
  <div class="text-center mb-8">
    <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">{eyebrow}</p>
    <h2 class="text-2xl md:text-3xl font-bold tracking-tighter font-heading">{heading}</h2>
  </div>
  <div class="grid md:grid-cols-2 gap-6">
    {
      items.map((t) => (
        <figure class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm">
          <blockquote class="text-base md:text-lg italic text-gray-800 dark:text-gray-200 leading-relaxed flex-1">
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <figcaption class="mt-5 text-sm text-muted">
            <span class="font-semibold text-gray-900 dark:text-white">
              {t.url ? (
                <a href={t.url} class="hover:text-accent underline-offset-2 hover:underline" rel="noopener" target="_blank">
                  {t.name}
                </a>
              ) : (
                t.name
              )}
            </span>
            <br />
            {t.title}
            {t.context && (
              <>
                <br />
                <span class="text-xs">{t.context}</span>
              </>
            )}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
