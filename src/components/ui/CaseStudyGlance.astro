---
interface Item {
  label: string;
  text: string;
  wide?: boolean;
}
interface Props {
  items: Item[];
  title?: string;
}
const { items = [], title = 'Case study at a glance' } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 md:px-8 py-10">
  <div
    class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 md:p-8 shadow-sm"
  >
    <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-5">{title}</p>
    <dl class="grid md:grid-cols-2 gap-x-10 gap-y-5">
      {
        items.map((item) => (
          <div class={item.wide ? 'md:col-span-2' : ''}>
            <dt class="text-xs font-bold uppercase tracking-wide text-accent mb-1">{item.label}</dt>
            <dd class="text-sm md:text-base text-gray-700 dark:text-gray-300 leading-relaxed">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
