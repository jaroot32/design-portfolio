---
import Layout from '~/layouts/PageLayout.astro';
import Features3 from '~/components/widgets/Features3.astro';
import P1 from '~/assets/images/P1.webp';
import P3 from '~/assets/images/P3.webp';
import profileImage from '~/assets/images/profile-bust.webp';
import splashHero from '~/assets/images/splash-hero.webp';
import facadeOffboarding from '~/assets/images/facade-offboarding.webp';
import facadeGemini from '~/assets/images/facade-gemini.webp';
import facadeHealthJourney from '~/assets/images/Health_Journey-Cover.png';

const metadata = {
  title: 'Jonathan Root | Learning Experience Designer & Instructional Designer',
  description:
    'Learning Experience Designer and Instructional Designer specializing in technical learning, eLearning development, Articulate Rise & Storyline, JavaScript, AI-enabled learning, and customer education.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- What I Do -->
  <div class="relative py-16 md:py-20 hero-section" style="min-height: 71vh;">
    <style define:vars={{ splashHeroSrc: `url('${splashHero.src}')` }}>
      @media (min-width: 768px) {
        .hero-section {
          background-image: var(--splashHeroSrc);
          background-repeat: round;
          background-size: cover;
          background-position: left;
        }
      }
    </style>

    <!-- Veil to keep text readable -->
    <div class="absolute inset-0 pointer-events-none bg-white/88 dark:bg-gray-950/90" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <img
          src={profileImage.src}
          alt="Jonathan Root"
          class="w-24 h-24 rounded-full object-cover shadow-md border-4 border-white dark:border-gray-700 mx-auto mb-5"
          style="object-position: 13px 20%;"
        />
        <p class="text-base text-secondary font-bold tracking-wide uppercase mb-2">What I Do</p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading mb-4">
          <span
            class="inline-block bg-gradient-to-r from-purple-500 via-pink-500 to-indigo-500 bg-clip-text text-transparent pb-[0.1em]"
            >I design technical learning experiences that turn complex systems into practical skills.</span
          >
        </h2>
        <p class="text-base md:text-lg font-semibold text-gray-700 dark:text-gray-300 mb-6 tracking-wide">
          Technical Curriculum Developer &middot; Learning Experience Designer &middot; eLearning Developer
        </p>
        <blockquote
          class="my-8 border-l-4 border-accent pl-5 text-left text-xl md:text-2xl font-semibold italic text-gray-900 dark:text-white"
        >
          I design and develop the interactive courseware that makes learning work. When the authoring
          tool can't do what the design calls for, I build it.
        </blockquote>
        <p class="text-lg md:text-xl text-gray-800 dark:text-gray-200 mb-4 text-justify">
          I design technical learning experiences that turn complex systems into practical skills: interactive eLearning, scenario-based courses, and microlearning for people who need to use a tool or apply a process, not just hear about it.
        </p>
        <p class="text-lg md:text-xl text-gray-800 dark:text-gray-200 mb-4 text-justify">
          I started in software development and spent eight years teaching adult learners, so I know where people get stuck, and I write the code when an authoring tool can't do what a design needs. I use AI daily, with a human review for accuracy.
        </p>
        <p class="text-lg md:text-xl text-gray-800 dark:text-gray-200 mb-4 text-justify">
          At LearningMate I served as a subject matter expert on Chegg Skills' web development certification,
          reviewing AI-assisted scripts, assessments, and finished Rise 360 builds for technical accuracy against
          client acceptance criteria. I recorded 17 demonstration videos and wrote content for a Rise 360 course on
          Gemini for a large health organization.
        </p>
        <p class="text-lg md:text-xl text-gray-800 dark:text-gray-200 mb-4 text-center">
          I want my work to move people from knowing to doing.
        </p>
        <div class="mt-8 flex flex-col items-center gap-4">
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-md bg-accent text-white font-semibold text-base hover:bg-accent/90 transition-colors duration-200 shadow-md"
          >
            See My Work
          </a>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 border border-green-200 dark:border-green-700">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
            </span>
            <span class="text-xs font-semibold text-green-800 dark:text-green-300 tracking-wide">Open to full-time remote roles in Learning Experience Design, Technical Curriculum Development & Customer Education. Contract work considered.</span>
          </div>
          <a
            href="#featured"
            aria-label="Scroll down to see featured work"
            class="mt-6 text-muted hover:text-accent transition-colors"
          >
            <svg
              class="w-7 h-7 animate-bounce"
              style="animation-duration: 2.8s;"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Project -->
  <div id="featured" class="py-16 md:py-20 scroll-mt-20">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <div class="mb-14">
        <div class="text-center mb-6">
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Hiring managers, start here</p>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tighter font-heading">Three pieces, three skills</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          <a href="/projects/healthcare-patient-journey" class="group flex flex-col p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent dark:hover:border-accent transition-all duration-200">
            <h3 class="text-base font-bold font-heading mb-2 group-hover:text-accent transition-colors duration-200">A Healthcare Patient Journey</h3>
            <p class="text-sm text-muted leading-relaxed flex-1"><strong>Technical build.</strong> A Storyline course with custom JavaScript, GSAP animation, and an embedded game.</p>
            <span class="mt-4 text-sm font-medium text-accent">View case study &rarr;</span>
          </a>
          <a href="/projects/high-risk-offboarding-storyline" class="group flex flex-col p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent dark:hover:border-accent transition-all duration-200">
            <h3 class="text-base font-bold font-heading mb-2 group-hover:text-accent transition-colors duration-200">The High-Risk Offboarding</h3>
            <p class="text-sm text-muted leading-relaxed flex-1"><strong>Design process.</strong> Needs analysis, branching decisions, and a personalized audit report.</p>
            <span class="mt-4 text-sm font-medium text-accent">View case study &rarr;</span>
          </a>
          <a href="/projects/chrome-extension-udacity" class="group flex flex-col p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent dark:hover:border-accent transition-all duration-200">
            <h3 class="text-base font-bold font-heading mb-2 group-hover:text-accent transition-colors duration-200">Chrome Extension, Udacity</h3>
            <p class="text-sm text-muted leading-relaxed flex-1"><strong>Tools that save time.</strong> Cut a recurring review from about an hour to about 20 minutes, later adopted platform-wide.</p>
            <span class="mt-4 text-sm font-medium text-accent">View case study &rarr;</span>
          </a>
        </div>
      </div>
      <div class="text-center mb-10">
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
          Featured Projects
        </p>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Selected Work</h2>
        <p class="text-lg text-muted mt-3">
          Rise 360 courses, microlearning, and branching scenarios, built as portfolio pieces across eLearning formats.
        </p>
      </div>
      <!-- Health Journey - full-width, featured first -->
      <div class="mb-12 flex flex-col">
        <h3 class="text-xl font-bold font-heading mb-2 text-gray-900 dark:text-white">A Healthcare Patient Journey</h3>
        <p class="text-sm text-muted mb-4">
          A five-slide Storyline 360 course built from a professional studio's design files, popup layers,
          AI-generated narration, GSAP-powered 3D card flips, and an embedded JavaScript word game
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          What I did: Instructional design &middot; Storyline build &middot; Custom JavaScript/GSAP &middot; AI
          narration production &middot; Build-walkthrough video
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          Tools: Articulate Storyline 360 &middot; Custom JavaScript &middot; Scope: Three decision points, four tracked variables, one personalized audit report
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          Tools: Articulate Storyline 360 &middot; JavaScript &middot; GSAP 3 &middot; AI narration &middot; Scope: Five-slide course built from a studio's design files
        </p>
        <div
          class="iframe-launcher relative w-full rounded-xl shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 mb-4"
          style="padding-top: 56.25%;"
          data-src="/Health%20Journey/story.html"
          data-title="A Healthcare Patient Journey: Storyline 360 Course"
        >
          <div class="absolute inset-0 cursor-pointer group select-none"
               style={`background-image: url('${facadeHealthJourney.src}'); background-size: cover; background-position: center;`}>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-200 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-center">
                <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-3">
                  <svg class="w-8 h-8 text-white ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <p class="text-white font-semibold text-lg drop-shadow">Launch Course</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/projects/healthcare-patient-journey"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
          >
            View Case Study
          </a>
        </div>
      </div>

      <!-- High-Risk Offboarding - full width -->
      <div class="mb-12 flex flex-col">
        <h3 class="text-xl font-bold font-heading mb-2 text-gray-900 dark:text-white">The High-Risk Offboarding</h3>
        <p class="text-sm text-muted mb-4">
          A compliance branching scenario for HR and IT leaders, three decisions, real consequences, and a
          JavaScript-generated audit report personalized to your exact decision path
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          What I did: Instructional design &middot; Scenario architecture &middot; Interaction design &middot;
          JavaScript development &middot; Assessment design
        </p>
        <div
          class="iframe-launcher relative w-full rounded-xl shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 mb-4"
          style="padding-top: 62.5%;"
          data-src="/high-risk-offboarding-content/story.html"
          data-title="The High-Risk Offboarding: Storyline Branching Scenario"
        >
          <div class="absolute inset-0 cursor-pointer group select-none"
               style={`background-image: url('${facadeOffboarding.src}'); background-size: cover; background-position: center;`}>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-200 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-center">
                <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-3">
                  <svg class="w-8 h-8 text-white ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <p class="text-white font-semibold text-lg drop-shadow">Launch Course</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/projects/high-risk-offboarding-storyline"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
          >
            View Case Study
          </a>
        </div>
      </div>

      <!-- Gemini Course - full width -->
      <div class="mb-12 flex flex-col">
        <h3 class="text-xl font-bold font-heading mb-2 text-gray-900 dark:text-white">Work Smarter with Gemini</h3>
        <p class="text-sm text-muted mb-4">
          A practical Rise 360 course on Gemini Gem creation for a large health organization, designed and built independently as a portfolio piece
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          What I did: Instructional design &middot; Rise 360 build &middot; Content curation
        </p>
        <p class="text-xs font-semibold uppercase tracking-wide text-muted mb-4">
          Tools: Articulate Rise 360 &middot; Scope: Self-paced course for a large health organization audience, built independently
        </p>
        <div
          class="iframe-launcher relative w-full rounded-xl shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 mb-4"
          style="padding-top: 62.5%;"
          data-src="/gemini-course"
          data-title="Work Smarter with Gemini: Rise 360 Course"
        >
          <div class="absolute inset-0 cursor-pointer group select-none"
               style={`background-image: url('${facadeGemini.src}'); background-size: cover; background-position: center;`}>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-200 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-center">
                <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mx-auto mb-3">
                  <svg class="w-8 h-8 text-white ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <p class="text-white font-semibold text-lg drop-shadow">Launch Course</p>
              </div>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/projects/gemini-rise-course"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
          >
            View Case Study
          </a>
          <a
            href="/gemini-course"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 border-2 border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
          >
            Open Course
          </a>
        </div>
      </div>

      <!-- Rumie Byte - full-width card below the 2-column grid -->
      <div
        class="mt-10 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm p-8 flex flex-col md:flex-row gap-8 items-start"
      >
        <div class="flex-1">
          <p class="text-xs font-bold uppercase tracking-widest text-accent mb-2">
            Microlearning · OER · 2 Published Bytes
          </p>
          <h3 class="text-xl font-bold font-heading mb-2 text-gray-900 dark:text-white">
            How I Became a Better Listener in 3 Steps, Rumie Byte
          </h3>
          <p class="text-sm text-muted mb-5">
            My second published microlearning Byte on Rumie-Learn, a free global OER platform reaching learners across
            180+ countries. A 3-step, under-5-minute soft-skill experience built with a problem-first hook, two spaced
            knowledge checks, and plain language for a global audience. See also my first Byte,
            <a href="/projects/rumie-travel-anxiety-byte" class="text-accent hover:underline"
              >How I Dealt with Travel Anxiety</a
            >.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/projects/rumie-better-listener-byte"
              class="inline-flex items-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
            >
              View Project
            </a>
            <a
              href="https://learn.rumie.org/jR/bytes/how-i-became-a-better-listener-in-3-steps/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border-2 border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
            >
              Take the Byte
            </a>
          </div>
        </div>
        <div class="w-full md:w-72 shrink-0 space-y-3 text-sm">
          {
            [
              { label: 'Platform', value: 'Rumie-Learn (OER)' },
              { label: 'Format', value: '3 steps · under 5 min' },
              { label: 'Audience', value: 'Global · 180+ countries' },
              { label: 'Review', value: 'Peer reviewed · 2nd published Byte' },
            ].map(({ label, value }) => (
              <div class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 dark:border-gray-700">
                <p class="font-semibold text-gray-700 dark:text-gray-300 w-20 shrink-0">{label}</p>
                <p class="text-muted">{value}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Bio split layout -->
  <div id="about" class="mx-auto max-w-7xl px-4 md:px-8 py-12 md:py-16 scroll-mt-20">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <!-- Left: text + stats -->
      <div>
        <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-3">Background</p>
        <h2 class="text-3xl md:text-4xl font-bold font-heading mb-6 text-gray-900 dark:text-white">
          Technical depth meets instructional design craft
        </h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
          I design learning that earns its place: practical, technically grounded content that helps people <em
            >do the thing</em
          >, not just know about it.
        </p>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-8">
          Over eight years I've worked across curriculum design, code, interactive courseware, and live instruction for
          career-changers at global bootcamps and enterprise clients. I understand the technology well enough to build
          it, and I've taught it to hundreds of learners.
        </p>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-8">
          At LearningMate I reviewed AI-assisted course content for technical accuracy and wrote content for Rise 360
          courses. I work closely with subject matter experts and turn complex content into learning that works.
        </p>
        <div class="grid grid-cols-3 gap-4 border-t border-gray-200 dark:border-gray-700 pt-8">
          {
            [
              { stat: '8+ years', label: 'Technical education & learning design' },
              { stat: '1,000+', label: 'Career-material reviews sped up with a tool I built (about 1 hour down to about 20 minutes)' },
              { stat: 'Grad. Certificate', label: 'Learning Design & Technology (Dec 2025): M.S. in progress, expected May 2027' },
            ].map(({ stat, label }) => (
              <div>
                <p class="text-3xl md:text-4xl font-bold font-heading text-accent leading-none">{stat}</p>
                <p class="text-sm text-muted mt-2 leading-snug">{label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right: media bento -->
      <div class="space-y-3">
        <a
          href="/projects/mentoring-students-disabilities"
          class="group relative block overflow-hidden rounded-xl aspect-video bg-gray-100 dark:bg-gray-800"
        >
          <img
            src={P1.src}
            alt="Jonathan Root leading a live webinar on mentoring students with disabilities for OpenClassrooms"
            class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-60"
          />
          <div
            class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          >
            <span class="bg-white text-gray-900 font-semibold text-sm px-4 py-2 rounded-full shadow-md"
              >View Case Study</span
            >
          </div>
        </a>
        
      </div>
    </div>
  </div>

  <!-- Why Technical Learning -->
  <div class="mx-auto max-w-7xl px-4 md:px-8 py-12 md:py-16 border-t border-gray-200 dark:border-gray-800">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl md:text-4xl font-bold font-heading mb-4 text-gray-900 dark:text-white">
        Why technical learning?
      </h2>
      <p class="text-lg text-gray-700 dark:text-gray-300">
        I started in software development and spent years teaching people how to build software. Today, I bring
        that technical depth into instructional design.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        [
          {
            title: 'I understand the technology',
            body: 'APIs, JavaScript, developer tools, software workflows, web technologies.',
          },
          {
            title: 'I understand the learner',
            body: '8+ years working with career changers, developers, college students, and working professionals.',
          },
          {
            title: 'I can build the experience',
            body: 'Rise, Storyline, JavaScript, video, interactive web experiences.',
          },
        ].map(({ title, body }) => (
          <div class="text-center md:text-left">
            <h3 class="text-lg font-bold font-heading mb-2 text-gray-900 dark:text-white">{title}</h3>
            <p class="text-base text-gray-700 dark:text-gray-300">{body}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Areas of Expertise -->
  <Features3
    tagline="Skill Set"
    title="Areas of Expertise"
    subtitle="A cross-disciplinary skill set spanning design, development, and learning science."
    columns={2}
    items={[
      {
        title: 'AI-Assisted Workflows',
        description:
          'Using AI to draft, review, and refine learning content, with a human check for accuracy and learning goals before anything ships.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Technical Learning Design',
        description:
          'Structured, outcome-driven learning grounded in ADDIE, SAM, and adult learning theory: objectives, assessment alignment, and course architecture.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'eLearning Development',
        description:
          'Building interactive courses in Articulate Storyline 360 and Rise 360, extended with custom JavaScript for dynamic behavior.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Accessibility & Inclusive Design',
        description:
          'Applying WCAG standards and Universal Design for Learning principles across all instructional materials.',
        icon: 'tabler:accessible',
      },
    ]}
  />

  <!-- Organizations: Technical Education & Mentorship era -->
  <Features3
    tagline="2018–2025 · Technical Education & Mentorship"
    title="Organizations I've Worked With"
    subtitle="8+ years teaching the web to career changers, college students, and working professionals."
    columns={3}
    items={[
      {
        title: 'Udacity',
        description: 'Web development mentorship and project feedback for career-track learners.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Springboard',
        description: 'One-on-one mentorship and curriculum support for tech career changers.',
        icon: 'tabler:headset',
      },
      {
        title: 'OpenClassrooms',
        description: 'Jury Member evaluating student project defenses for online degree programs.',
        icon: 'tabler:gavel',
      },
      {
        title: 'Masterschool',
        description: 'Coding bootcamp instructor for tech career training and developer education programs.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Tacoma Community College',
        description: 'Web development and technology instruction in a community college setting.',
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Organizations: Technical Learning & eLearning Development era -->
  <Features3
    tagline="2023–2026 · Technical Learning & eLearning Development"
    title="Building the Learning Itself"
