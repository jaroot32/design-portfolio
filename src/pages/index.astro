<script>
  function initResumeModal() {
    const btn = document.getElementById('resume-request-btn');
    const modal = document.getElementById('resume-modal');
    const backdrop = document.getElementById('modal-backdrop');
    const closeBtn = document.getElementById('modal-close');
    const form = document.getElementById('resume-form') as HTMLFormElement | null;
    const successEl = document.getElementById('resume-success');
    const errorEl = document.getElementById('resume-error');
    const submitBtn = document.getElementById('resume-submit');

    if (!btn || !modal || !form) return;

    const openModal = () => {
      modal.style.removeProperty('display');
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      document.getElementById('r-first-name')?.focus();
    };

    const closeModal = () => {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;

      submitBtn.textContent = 'Sending…';
      (submitBtn as HTMLButtonElement).disabled = true;
      errorEl?.classList.add('hidden');

      try {
        const res = await fetch('https://formspree.io/f/maqkznkr', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.classList.add('hidden');
          successEl?.classList.remove('hidden');
        } else {
          throw new Error('Formspree error');
        }
      } catch {
        errorEl?.classList.remove('hidden');
        submitBtn.textContent = 'Send Request';
        (submitBtn as HTMLButtonElement).disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', initResumeModal);

  function initIframeLaunchers() {
    document.querySelectorAll<HTMLElement>('.iframe-launcher').forEach((container) => {
      container.addEventListener('click', () => {
        const src = container.dataset.src;
        const title = container.dataset.title ?? '';
        if (!src) return;
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = title;
        iframe.className = 'absolute inset-0 w-full h-full';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allowfullscreen', '');
        container.innerHTML = '';
        container.appendChild(iframe);
      });
    });
  }

  document.addEventListener('astro:page-load', initIframeLaunchers);
</script>
