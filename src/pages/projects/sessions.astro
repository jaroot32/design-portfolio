---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '1:1 Recorded Sessions — Chegg Skills & OpenClassrooms',
};

const sessions = [
  {
    id: 'IT-0RH_gg1A',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'Git Setup & DevTools Walkthrough',
    description:
      'Chrome DevTools dark theme, git config setup, terminal navigation — working through the tooling that the curriculum assumed was already in place.',
  },
  {
    id: '8ctHJsPHJPI',
    type: 'Coaching',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
    title: 'Pre-Assessment Debrief',
    description:
      'Student completed the JavaScript take-home in an hour. Session shifted to program overview, early exit patterns, ES6 preview, and strategy for the gap before the December cohort.',
  },
  {
    id: 'yCdyMUm9uFM',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'Terminal Fundamentals: Filesystem Navigation & Unix Commands',
    description:
      'Core terminal skills from scratch — navigating with pwd, ls, and cd, then creating and organizing files using mkdir, touch, cp, and mv. Includes the -R recursive flag and when to use it.',
  },
  {
    id: 'wDZ0r0OVWZU',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'VS Code Debugger Troubleshooting: Run & Debug with Node.js',
    description:
      "Live troubleshooting when the VS Code debugger wouldn't show the Node.js environment selector. Covers the debug panel, JavaScript vs. Node.js debug terminal, and an alternative workflow using Live Server + Chrome DevTools with breakpoints.",
  },
  {
    id: 'Cs5r5mmTi70',
    type: 'Coaching',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
    title: 'HTML Revision Debrief & Campgrounds Challenge: Accumulator Pattern on Qualified.io',
    description:
      'Reviewed a rejected HTML revision — identified it as a link mix-up, not a code issue — then walked through the evaluation structure before working the campgroundCapacity challenge live on Qualified.io. Covers accumulator pattern, isReserved conditionals, and the habit of reading problem instructions before writing code.',
  },
  {
    id: '_-l_H577SCY',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'CSS Flexbox Portfolio Review: Layout, Image Sizing & GitHub Pages',
    description:
      'Reviewed a submitted CSS/Flexbox portfolio project — covering flexbox vs. HTML tables, wrapping images in div containers for better sizing control, and using max-width/max-height together to maintain circular image proportions. Student successfully pushed to GitHub Pages from terminal using git.',
  },
  {
    id: 'X_EIuFFDH_w',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'JavaScript Plagiarism Checker: Bracket Notation & `.includes()` on Array of Objects',
    description:
      'Debugged a JavaScript plagiarism detection function — working through why `.push()` fails on an object, how to access nested string properties with bracket notation (`answers[i].response`), and using `.includes(checkText)` to detect matching text. Includes a conversation on the 20–30 minute debugging limit before reaching out for help.',
  },
  {
    id: '1bJ9dDXjbXs',
    type: 'Coaching',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
    title: 'Prep Program Orientation: JS Roadmap, VS Code & Free Learning Resources',
    description:
      'First session with a new student entering the Thinkful prep program — setting expectations for JavaScript fundamentals, framing problem-solving as the core skill, and building a supplemental resource stack. Covers Live Server in VS Code, when to use Replit vs. a local editor, and free practice options including freeCodeCamp and SoloLearn.',
  },
  {
    id: '0g2ex27vW-I',
    type: 'Technical',
    program: 'Chegg Skills / Thinkful',
    typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
    title: 'CSS Hover Effects Debugging: Overlay Animations, Absolute Positioning & Font Awesome',
    description:
      'Debugging hover overlay animations on a restaurant menu card project — tracing why CSS checkmark and fade-in effects worked on the desserts page but broke on entrees and main dishes. Walks through Chrome DevTools hover state simulation, the absolute/relative positioning parent-child relationship, diagnosing conflicting margin and padding as the root cause, and fixing the Font Awesome script placement.',
  },
  {
    id: 'hg5jzX0-kxs',
    type: 'Technical',
    program: 'OpenClassrooms / Guild',
    typeColor: 'bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200',
    title: 'CSS Responsive Design: Flexbox & Media Queries',
    description:
      'Flexbox wrap behavior, desktop-first media queries, and a mobile layout built from scratch the night before a project review — with live DevTools debugging throughout.',
  },
  {
    id: '9yzL3Ays6rM',
    type: 'Technical',
    program: 'OpenClassrooms / Guild',
    typeColor: 'bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200',
    title: 'Cart Delete: Event Delegation, getAttribute & Local Storage Splice',
    description:
      'Debugged a shopping cart delete button that removed items from the DOM but not from local storage — working through event delegation, why dot notation fails on data attributes, getAttribute() as the fix, and using splice() to remove the matched item from the local storage cart array.',
  },
];

const featuredSession = sessions[0];
const gallerySessions = sessions.slice(1);
---

<Layout metadata={metadata}>
  <Hero tagline="1:1 Student Support · Live Code Review · Career Coaching">
    <Fragment slot="title">
      1:1 Mentoring &amp; Technical Expert —<br />
      <span class="text-accent dark:text-white">Chegg Skills &amp; OpenClassrooms</span>
    </Fragment>
    <Fragment slot="subtitle">
      Recorded one-on-one sessions from two programs — Thinkful Engineering Immersion Prep (Chegg Skills) and
      OpenClassrooms Web Developer Mentoring for Guild Education students. Technical walkthroughs, live debugging, and
      coaching conversations with career-changing adults.
    </Fragment>
  </Hero>

  <!-- The Programs -->
  <Content tagline="The Programs" title="Two programs, one consistent role." isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12">
        <div class="text-center space-y-6">
          <div>
            <p class="text-4xl font-bold font-heading text-accent leading-none">Chegg</p>
            <p class="text-sm text-muted mt-1">Skills / Thinkful</p>
          </div>
          <div class="w-px h-8 bg-gray-300 dark:bg-gray-600 mx-auto"></div>
          <div>
            <p class="text-4xl font-bold font-heading text-accent leading-none">OC</p>
            <p class="text-sm text-muted mt-1">OpenClassrooms / Guild Ed.</p>
          </div>
          <div class="mt-6 space-y-1 text-sm text-muted">
            <p class="font-semibold text-gray-700 dark:text-gray-300">Technical Expert · Web Developer Mentor</p>
            <p>1:1 Sessions · Live Code Review</p>
            <p>Career-Changing Adults</p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        As a Technical Expert at Chegg Skills (Thinkful), I supported students enrolled in the Engineering Immersion
        Prep program — meeting one-on-one via Zoom to review GitHub submissions, write graded feedback, and troubleshoot
        technical blockers in real time. The students were career-changers hitting their first real wall with developer
        tooling, terminal navigation, and JavaScript fundamentals.
      </p>
      <p class="mb-4">
        As a Web Developer Mentor at OpenClassrooms, I held regular 1:1 sessions with Guild Education students — working
        adults at companies like Walmart, Chipotle, and Disney who were upskilling into web development while working
        full-time. They often reached out the night before a project review deadline. The sessions had to be direct,
        efficient, and leave them capable of finishing the work independently.
      </p>
      <p>
        Both roles required the same thing: show up to someone's specific problem, solve it live, and make sure they
        understand what happened — not just that it works now.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- The Work -->
  <Features3
    tagline="The Work"
    title="What 1:1 sessions involved"
    subtitle="Every session started with the student's actual problem — open in the browser, live in the code editor, with a deadline attached."
    columns={3}
    items={[
      {
        title: 'Live Code Review',
        description:
          'Opened student repos and shared screens to review code in real time — reading the error, identifying the root cause, and explaining the fix before touching a single line.',
        icon: 'tabler:code',
      },
      {
        title: 'JavaScript Debugging',
        description:
          'Worked through JS logic errors live — bracket notation vs. dot notation, array vs. object methods, accumulator patterns, closures, and event delegation on dynamically created elements.',
        icon: 'tabler:brand-javascript',
      },
      {
        title: 'CSS & Responsive Design',
        description:
          'Debugged flexbox layout issues, built mobile-first media queries from scratch, explained flex-wrap behavior, and coached students through presenting their responsive work to reviewers.',
        icon: 'tabler:layout-columns',
      },
      {
        title: 'Developer Tooling',
        description:
          'Walked through VS Code setup, Chrome DevTools, the Run & Debug panel, Live Server, terminal navigation, git config, and the full workflow from local file to GitHub Pages.',
        icon: 'tabler:tools',
      },
      {
        title: 'Project Review Coaching',
        description:
          "Helped students reframe what reviewers actually care about — demonstrated understanding of a concept, not pixel-perfect coverage. Coached how to present work confidently with what they'd built.",
        icon: 'tabler:presentation',
      },
      {
        title: 'Study Strategy & Mindset',
        description:
          'Addressed the non-technical blockers: when to stop debugging solo and ask for help, how to structure study time around a full-time job, and how to keep momentum when the material feels impossible.',
        icon: 'tabler:brain',
      },
    ]}
  />

  <!-- Sessions -->
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Sessions</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Recorded 1:1 Sessions</h2>
      <p class="text-lg text-muted mt-4">
        A growing collection of recorded sessions across both programs. Click any session to watch.
      </p>
    </div>

    <!-- Featured session -->
    <button
      data-video-id={featuredSession.id}
      class="group session-card text-left flex flex-col md:flex-row rounded-xl border border-gray-200 dark:border-gray-700 hover:border-accent dark:hover:border-accent transition-colors cursor-pointer w-full overflow-hidden mb-6"
    >
      <div class="relative w-full md:w-3/5 aspect-video flex-shrink-0 bg-gray-100 dark:bg-gray-800">
        <img
          src={`https://img.youtube.com/vi/${featuredSession.id}/hqdefault.jpg`}
          alt={featuredSession.title}
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div
          class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/25 transition-colors"
        >
          <div
            class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform"
          >
            <svg class="h-7 w-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
        </div>
      </div>
      <div class="p-6 flex flex-col justify-center">
        <div class="flex items-center gap-2 mb-3">
          <span class={`text-xs font-semibold px-3 py-1 rounded-full ${featuredSession.typeColor}`}
            >{featuredSession.type}</span
          >
          <span class="text-xs text-muted">{featuredSession.program}</span>
        </div>
        <p
          class="font-semibold text-lg text-gray-800 dark:text-gray-200 mb-3 group-hover:text-accent transition-colors leading-snug"
        >
          {featuredSession.title}
        </p>
        <p class="text-sm text-muted leading-relaxed">{featuredSession.description}</p>
        <p class="text-xs text-accent mt-4 font-medium">Watch Session →</p>
      </div>
    </button>

    <!-- Session gallery -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {
        gallerySessions.map((session) => (
          <button data-video-id={session.id} class="group session-card text-left cursor-pointer">
            <div class="relative aspect-video w-full rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700 group-hover:border-accent dark:group-hover:border-accent transition-colors bg-gray-100 dark:bg-gray-800">
              <img
                src={`https://img.youtube.com/vi/${session.id}/hqdefault.jpg`}
                alt={session.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/10 group-hover:bg-black/25 transition-colors">
                <div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center shadow-md group-hover:scale-110 transition-transform">
                  <svg class="h-4 w-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>
            </div>
            <div class="mt-2 px-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${session.typeColor}`}>
                  {session.type}
                </span>
                <span class="text-[10px] text-muted">{session.program}</span>
              </div>
              <p class="text-sm font-semibold text-gray-800 dark:text-gray-200 mt-1 leading-snug line-clamp-2 group-hover:text-accent transition-colors">
                {session.title}
              </p>
            </div>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Video Modal -->
  <div
    id="session-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Session video"
  >
    <div class="relative w-full max-w-4xl">
      <button
        id="modal-close"
        class="absolute -top-10 right-0 flex items-center gap-2 text-white/80 hover:text-white text-sm font-medium transition-colors"
        aria-label="Close video"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Close
      </button>
      <div class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl">
        <iframe
          id="modal-iframe"
          src=""
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <script>
    function initSessionModal() {
      const modal = document.getElementById('session-modal');
      const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
      const closeBtn = document.getElementById('modal-close');

      function openModal(videoId: string) {
        if (!modal || !iframe) return;
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal || !iframe) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        iframe.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.session-card').forEach((btn) => {
        btn.addEventListener('click', () => {
          const videoId = btn.getAttribute('data-video-id');
          if (videoId) openModal(videoId);
        });
      });

      closeBtn?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    }

    document.addEventListener('astro:page-load', initSessionModal);
  </script>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'View All Projects', href: '/projects' },
      { text: 'Get in Touch', href: '/about#contact' },
    ]}
  >
    <Fragment slot="title">Interested in working together?</Fragment>
    <Fragment slot="subtitle">
      I'm open to remote opportunities in technical learning experience design, developer education, and customer
      enablement.
    </Fragment>
  </CallToAction>
</Layout>
