---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = {
  title: 'The Enrollment Drop-Off Problem — Storyline Branching Scenario',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Instructional Design · Articulate Storyline 360 · A/B Testing · GrowthBook SDK">
    <Fragment slot="title">
      The Enrollment Drop-Off Problem —<br />
      <span class="text-accent dark:text-white">A Branching Scenario for Launchpath Academy</span>
    </Fragment>
    <Fragment slot="subtitle">
      A corporate instructional design portfolio piece following the full design process — needs analysis, learning
      objectives, storyboard, and a Storyline 360 branching scenario built around A/B testing with GrowthBook SDK.
    </Fragment>
  </Hero>

  <!-- Context -->
  <Content tagline="The Problem" title="34% of learners never complete enrollment" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12">
        <div class="text-center">
          <p class="text-7xl font-bold font-heading text-accent leading-none">34%</p>
          <p class="text-xl text-muted mt-3">Enrollment Drop-Off Rate</p>
          <div class="mt-8 space-y-2 text-sm text-muted">
            <p class="font-semibold text-gray-700 dark:text-gray-300">Launchpath Academy · SaaS EdTech</p>
            <p>GrowthBook SDK · A/B Testing</p>
            <p>Articulate Storyline 360</p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        Launchpath Academy is a growing SaaS edtech company whose revenue is directly tied to learner enrollment
        completion rates. Analytics revealed that 34% of learners who reached the enrollment confirmation page abandoned
        the process — a significant and measurable business problem.
      </p>
      <p class="mb-4">
        The suspected cause: CTA button copy reading "Complete Enrollment" felt final and intimidating rather than
        motivating. But the team had no evidence-based process for testing this hypothesis — they were making product
        decisions based on gut instinct rather than data.
      </p>
      <p>
        This module was designed to close that gap — giving L&D and product team members the knowledge and skills to
        design, implement, and interpret a proper A/B test using GrowthBook SDK.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- Design Process -->
  <Features3
    tagline="Design Process"
    title="From problem to published module"
    subtitle="Following a full instructional design process — analysis, design, development, and evaluation planning."
    columns={3}
    items={[
      {
        title: 'Needs Analysis',
        description:
          'Identified the performance gap, root cause, and audience profile before writing a single learning objective. The 34% drop-off was a symptom — the root cause was a knowledge and skill gap in evidence-based product decision-making.',
        icon: 'tabler:search',
      },
      {
        title: 'Learning Objectives',
        description:
          "Four objectives written to Bloom's Taxonomy — progressing from Knowledge (define a testable hypothesis) through Application (configure GrowthBook) to Analysis (interpret results) and Synthesis (connect to business outcomes).",
        icon: 'tabler:target',
      },
      {
        title: 'Storyboard',
        description:
          'A full slide-by-slide storyboard documented before building — mapping each decision point, branching path, consequence screen, and debrief to specific learning objectives.',
        icon: 'tabler:layout-board',
      },
      {
        title: 'Branching Scenario',
        description:
          'Built in Articulate Storyline 360 — three decision points mirroring the real A/B testing workflow. Wrong answers produce realistic consequence screens, not grade penalties. Learning from failure is more durable.',
        icon: 'tabler:git-branch',
      },
      {
        title: 'GrowthBook SDK Integration',
        description:
          'Decision 2 surfaces real GrowthBook SDK code — making the scenario concrete and tool-specific. Learners see what implementation actually looks like, not an abstraction.',
        icon: 'tabler:code',
      },
      {
        title: 'Kirkpatrick Evaluation',
        description:
          'Evaluation planned across all four levels — from post-module confidence ratings (Level 1) through behavioral follow-up on real product decisions (Level 3) to enrollment completion rate improvement (Level 4).',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Module Embed -->
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Storyline Module</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Take the Scenario</h2>
      <p class="text-lg text-muted mt-4">
        A branching Storyline 360 scenario — three decisions, real consequences, and a debrief connecting A/B testing to
        business outcomes at Launchpath Academy.
      </p>
    </div>
    <div
      class="relative w-full rounded-lg shadow-lg overflow-hidden border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 flex items-center justify-center"
      style="min-height: 360px;"
    >
      <div class="text-center px-8 py-16">
        <div
          class="w-16 h-16 rounded-full bg-accent/10 dark:bg-accent/20 flex items-center justify-center mx-auto mb-5"
        >
          <svg class="w-8 h-8 text-accent" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>
        <p class="text-2xl font-bold font-heading text-gray-800 dark:text-gray-200 mb-2">Module Coming Soon</p>
        <p class="text-muted text-base max-w-md mx-auto">
          The Storyline module is currently in development. Check back shortly.
        </p>
      </div>
    </div>
  </div>

  <!-- Learning Objectives -->
  <Content tagline="Learning Design" title="Objectives written to Bloom's Taxonomy" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12 px-6">
        <div class="w-full max-w-xs space-y-3">
          {
            [
              {
                label: 'Define a testable hypothesis',
                detail: 'Knowledge — framing the right question',
                color: 'blue',
              },
              { label: 'Configure the experiment', detail: 'Application — GrowthBook SDK setup', color: 'green' },
              { label: 'Interpret the results', detail: 'Analysis — p-value and lift percentage', color: 'purple' },
              { label: 'Connect to business outcomes', detail: 'Synthesis — data-driven decisions', color: 'orange' },
            ].map(({ label, detail, color }) => (
              <div
                class={`flex items-start gap-3 p-2.5 rounded-lg border ${color === 'blue' ? 'border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20' : color === 'green' ? 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20' : color === 'purple' ? 'border-purple-200 dark:border-purple-800 bg-purple-50 dark:bg-purple-900/20' : 'border-orange-200 dark:border-orange-800 bg-orange-50 dark:bg-orange-900/20'}`}
              >
                <div>
                  <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">{label}</p>
                  <p class="text-xs text-muted mt-0.5">{detail}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        The four learning objectives follow a deliberate Bloom's Taxonomy progression — starting with defining a
        testable hypothesis (Knowledge), moving through configuring a real GrowthBook experiment (Application),
        interpreting statistical results (Analysis), and synthesizing the experience into a business decision
        (Synthesis).
      </p>
      <p class="mb-4">
        The most common failure mode in A/B testing isn't the implementation — it's the interpretation. Teams either
        ship too early (misreading noise as signal) or wait too long (not recognizing a clear win). Decision 3 is
        designed specifically to build that judgment.
      </p>
      <p>
        Evaluation is planned across all four Kirkpatrick levels — from immediate confidence ratings through behavioral
        follow-up to measurable improvement in Launchpath Academy's enrollment completion rate.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern"></div>
    </Fragment>
  </Content>

  <!-- Branching Diagram -->
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        Branching Architecture
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">
        Three Decisions. One Path to Evidence.
      </h2>
      <p class="text-lg text-muted mt-4 max-w-2xl mx-auto">
        Decisions 1 and 2 use slide layers — wrong answers give feedback and loop back. Decision 3 branches to three
        distinct consequence slides before converging at the debrief.
      </p>
    </div>
    <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-4 overflow-x-auto">
      <svg
        viewBox="0 0 820 700"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        style="width:100%;max-width:820px;display:block;margin:0 auto;"
        font-family="Arial, sans-serif"
      >
        <title>Enrollment Drop-Off Storyline Branching Diagram</title>
        <desc
          >A flowchart showing the branching structure of the Enrollment Drop-Off Storyline module — decisions 1 and 2
          use layers with retry loops, while decision 3 branches to three consequence slides that converge at the
          debrief.</desc
        >
        <defs>
          <marker id="ed-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"
            ><path d="M0,0 L0,6 L8,3 z" fill="#6b7280"></path></marker
          >
          <marker id="ed-arrow-red" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"
            ><path d="M0,0 L0,6 L8,3 z" fill="#dc2626"></path></marker
          >
          <marker id="ed-arrow-green" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"
            ><path d="M0,0 L0,6 L8,3 z" fill="#16a34a"></path></marker
          >
          <marker id="ed-arrow-amber" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"
            ><path d="M0,0 L0,6 L8,3 z" fill="#d97706"></path></marker
          >
        </defs>
        <!-- SLIDES 1-5 INTRO -->
        <rect x="285" y="10" width="250" height="44" rx="8" fill="#7c3aed"></rect>
        <text x="410" y="28" text-anchor="middle" fill="white" font-size="11" font-weight="bold">SLIDES 1–5</text>
        <text x="410" y="44" text-anchor="middle" fill="#ddd6fe" font-size="10">Hook · Context · A/B Testing Intro</text
        >
        <!-- Arrow S1-5 → D1 -->
        <line x1="410" y1="54" x2="410" y2="78" stroke="#6b7280" stroke-width="1.5" marker-end="url(#ed-arrow)"></line>
        <!-- DECISION 1 -->
        <rect x="260" y="80" width="300" height="48" rx="8" fill="#1e3a5f"></rect>
        <text x="410" y="99" text-anchor="middle" fill="white" font-size="11" font-weight="bold"
          >DECISION 1 — SLIDE 6</text
        >
        <text x="410" y="116" text-anchor="middle" fill="#93c5fd" font-size="10">Form a Hypothesis</text>
        <!-- D1 left arm: Option A (Too Vague) -->
        <line x1="260" y1="104" x2="150" y2="104" stroke="#dc2626" stroke-width="1.5"></line>
        <line x1="150" y1="104" x2="150" y2="153" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ed-arrow-red)"
        ></line>
        <text x="202" y="97" text-anchor="middle" fill="#dc2626" font-size="9">Option A</text>
        <!-- D1 right arm: Option C (Too Broad) -->
        <line x1="560" y1="104" x2="670" y2="104" stroke="#dc2626" stroke-width="1.5"></line>
        <line x1="670" y1="104" x2="670" y2="153" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ed-arrow-red)"
        ></line>
        <text x="618" y="97" text-anchor="middle" fill="#dc2626" font-size="9">Option C</text>
        <!-- D1 center correct -->
        <line x1="410" y1="128" x2="410" y2="226" stroke="#16a34a" stroke-width="1.5" marker-end="url(#ed-arrow-green)"
        ></line>
        <text x="425" y="183" fill="#16a34a" font-size="9">Option B ✓</text>
        <!-- D1 wrong boxes (layers) -->
        <rect x="40" y="155" width="220" height="52" rx="6" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"></rect>
        <text x="150" y="173" text-anchor="middle" fill="#dc2626" font-size="10" font-weight="bold">TOO VAGUE</text>
        <text x="150" y="187" text-anchor="middle" fill="#7f1d1d" font-size="9">"Users feel it's too final"</text>
        <text x="150" y="200" text-anchor="middle" fill="#9ca3af" font-size="9">Layer → Try Again</text>
        <rect x="560" y="155" width="220" height="52" rx="6" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"></rect>
        <text x="670" y="173" text-anchor="middle" fill="#dc2626" font-size="10" font-weight="bold">TOO BROAD</text>
        <text x="670" y="187" text-anchor="middle" fill="#7f1d1d" font-size="9">"Redesign entire page"</text>
        <text x="670" y="200" text-anchor="middle" fill="#9ca3af" font-size="9">Layer → Try Again</text>
        <!-- D1 dashed return arrows -->
        <path
          d="M40,181 C15,181 15,104 260,104"
          stroke="#dc2626"
          stroke-width="1"
          stroke-dasharray="4,3"
          fill="none"
          marker-end="url(#ed-arrow-red)"></path>
        <path
          d="M780,181 C805,181 805,104 560,104"
          stroke="#dc2626"
          stroke-width="1"
          stroke-dasharray="4,3"
          fill="none"
          marker-end="url(#ed-arrow-red)"></path>
        <!-- DECISION 2 -->
        <rect x="260" y="228" width="300" height="48" rx="8" fill="#1e3a5f"></rect>
        <text x="410" y="247" text-anchor="middle" fill="white" font-size="11" font-weight="bold"
          >DECISION 2 — SLIDE 7</text
        >
        <text x="410" y="264" text-anchor="middle" fill="#93c5fd" font-size="10"
          >Configure the Test (Traffic Split)</text
        >
        <!-- D2 left arm: 80/20 -->
        <line x1="260" y1="252" x2="150" y2="252" stroke="#dc2626" stroke-width="1.5"></line>
        <line x1="150" y1="252" x2="150" y2="303" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ed-arrow-red)"
        ></line>
        <text x="202" y="245" text-anchor="middle" fill="#dc2626" font-size="9">80/20</text>
        <!-- D2 right arm: 90/10 -->
        <line x1="560" y1="252" x2="670" y2="252" stroke="#dc2626" stroke-width="1.5"></line>
        <line x1="670" y1="252" x2="670" y2="303" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ed-arrow-red)"
        ></line>
        <text x="618" y="245" text-anchor="middle" fill="#dc2626" font-size="9">90/10</text>
        <!-- D2 center correct -->
        <line x1="410" y1="276" x2="410" y2="376" stroke="#16a34a" stroke-width="1.5" marker-end="url(#ed-arrow-green)"
        ></line>
        <text x="425" y="332" fill="#16a34a" font-size="9">50/50 ✓</text>
        <!-- D2 wrong boxes (layers) -->
        <rect x="40" y="303" width="220" height="52" rx="6" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"></rect>
        <text x="150" y="321" text-anchor="middle" fill="#dc2626" font-size="10" font-weight="bold">UNEVEN SPLIT</text>
        <text x="150" y="335" text-anchor="middle" fill="#7f1d1d" font-size="9">Slow to significance</text>
        <text x="150" y="348" text-anchor="middle" fill="#9ca3af" font-size="9">Layer → Try Again</text>
        <rect x="560" y="303" width="220" height="52" rx="6" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"></rect>
        <text x="670" y="321" text-anchor="middle" fill="#dc2626" font-size="10" font-weight="bold">TOO SMALL</text>
        <text x="670" y="335" text-anchor="middle" fill="#7f1d1d" font-size="9">Months to collect data</text>
        <text x="670" y="348" text-anchor="middle" fill="#9ca3af" font-size="9">Layer → Try Again</text>
        <!-- D2 dashed return arrows -->
        <path
          d="M40,329 C15,329 15,252 260,252"
          stroke="#dc2626"
          stroke-width="1"
          stroke-dasharray="4,3"
          fill="none"
          marker-end="url(#ed-arrow-red)"></path>
        <path
          d="M780,329 C805,329 805,252 560,252"
          stroke="#dc2626"
          stroke-width="1"
          stroke-dasharray="4,3"
          fill="none"
          marker-end="url(#ed-arrow-red)"></path>
        <!-- SLIDE 8 RESULTS -->
        <rect x="285" y="378" width="250" height="44" rx="8" fill="#0f4c81"></rect>
        <text x="410" y="396" text-anchor="middle" fill="white" font-size="11" font-weight="bold"
          >SLIDE 8 — RESULTS ARE IN</text
        >
        <text x="410" y="412" text-anchor="middle" fill="#93c5fd" font-size="10"
          >Variant B wins · p=0.03 · lift +12%</text
        >
        <!-- Arrow S8 → D3 -->
        <line x1="410" y1="422" x2="410" y2="446" stroke="#6b7280" stroke-width="1.5" marker-end="url(#ed-arrow)"
        ></line>
        <!-- DECISION 3 -->
        <rect x="260" y="448" width="300" height="48" rx="8" fill="#1e3a5f"></rect>
        <text x="410" y="467" text-anchor="middle" fill="white" font-size="11" font-weight="bold"
          >DECISION 3 — SLIDE 9</text
        >
        <text x="410" y="484" text-anchor="middle" fill="#93c5fd" font-size="10">What Do You Do With the Results?</text>
        <!-- D3 left arm: Run Longer (amber) -->
        <line x1="260" y1="472" x2="145" y2="472" stroke="#d97706" stroke-width="1.5"></line>
        <line x1="145" y1="472" x2="145" y2="541" stroke="#d97706" stroke-width="1.5" marker-end="url(#ed-arrow-amber)"
        ></line>
        <text x="198" y="465" text-anchor="middle" fill="#d97706" font-size="9">Option A</text>
        <!-- D3 center: Ship It (green) -->
        <line x1="410" y1="496" x2="410" y2="541" stroke="#16a34a" stroke-width="1.5" marker-end="url(#ed-arrow-green)"
        ></line>
        <text x="425" y="522" fill="#16a34a" font-size="9">Option B ✓</text>
        <!-- D3 right arm: Test More (red) -->
        <line x1="560" y1="472" x2="675" y2="472" stroke="#dc2626" stroke-width="1.5"></line>
        <line x1="675" y1="472" x2="675" y2="541" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ed-arrow-red)"
        ></line>
        <text x="622" y="465" text-anchor="middle" fill="#dc2626" font-size="9">Option C</text>
        <!-- D3 consequence boxes -->
        <rect x="20" y="543" width="250" height="52" rx="6" fill="#fffbeb" stroke="#d97706" stroke-width="1.5"></rect>
        <text x="145" y="561" text-anchor="middle" fill="#d97706" font-size="10" font-weight="bold">RUN LONGER</text>
        <text x="145" y="575" text-anchor="middle" fill="#78350f" font-size="9">~$113K opportunity cost</text>
        <text x="145" y="588" text-anchor="middle" fill="#9ca3af" font-size="9">Slide 10 → Debrief</text>
        <rect x="290" y="543" width="240" height="52" rx="6" fill="#f0fdf4" stroke="#16a34a" stroke-width="1.5"></rect>
        <text x="410" y="561" text-anchor="middle" fill="#16a34a" font-size="10" font-weight="bold">SHIP IT ✓</text>
        <text x="410" y="575" text-anchor="middle" fill="#14532d" font-size="9">~$56K monthly revenue recovered</text>
        <text x="410" y="588" text-anchor="middle" fill="#9ca3af" font-size="9">Slide 12 → Debrief</text>
        <rect x="555" y="543" width="245" height="52" rx="6" fill="#fef2f2" stroke="#dc2626" stroke-width="1.5"></rect>
        <text x="677" y="561" text-anchor="middle" fill="#dc2626" font-size="10" font-weight="bold">ABANDON WINNER</text
        >
        <text x="677" y="575" text-anchor="middle" fill="#7f1d1d" font-size="9">Enrollment stays at 66%</text>
        <text x="677" y="588" text-anchor="middle" fill="#9ca3af" font-size="9">Slide 11 → Debrief</text>
        <!-- Convergence to Debrief -->
        <line x1="145" y1="595" x2="145" y2="661" stroke="#6b7280" stroke-width="1.5"></line>
        <line x1="145" y1="661" x2="285" y2="661" stroke="#6b7280" stroke-width="1.5" marker-end="url(#ed-arrow)"
        ></line>
        <line x1="410" y1="595" x2="410" y2="641" stroke="#6b7280" stroke-width="1.5" marker-end="url(#ed-arrow)"
        ></line>
        <line x1="677" y1="595" x2="677" y2="661" stroke="#6b7280" stroke-width="1.5"></line>
        <line x1="677" y1="661" x2="535" y2="661" stroke="#6b7280" stroke-width="1.5" marker-end="url(#ed-arrow)"
        ></line>
        <!-- DEBRIEF -->
        <rect x="285" y="643" width="250" height="44" rx="8" fill="#7c3aed"></rect>
        <text x="410" y="661" text-anchor="middle" fill="white" font-size="11" font-weight="bold"
          >SLIDE 13 — DEBRIEF</text
        >
        <text x="410" y="677" text-anchor="middle" fill="#ddd6fe" font-size="10"
          >Decision Review · Score · Confidence Rating</text
        >
        <!-- LEGEND -->
        <rect x="10" y="10" width="145" height="115" rx="6" fill="none" stroke="#e5e7eb" stroke-width="1"></rect>
        <text x="20" y="26" fill="#6b7280" font-size="9" font-weight="bold">LEGEND</text>
        <rect x="20" y="34" width="10" height="10" rx="2" fill="#dc2626"></rect>
        <text x="36" y="43" fill="#374151" font-size="9">Wrong Answer</text>
        <rect x="20" y="50" width="10" height="10" rx="2" fill="#d97706"></rect>
        <text x="36" y="59" fill="#374151" font-size="9">Risky Choice</text>
        <rect x="20" y="66" width="10" height="10" rx="2" fill="#16a34a"></rect>
        <text x="36" y="75" fill="#374151" font-size="9">Correct Path</text>
        <rect x="20" y="82" width="10" height="10" rx="2" fill="#0f4c81"></rect>
        <text x="36" y="91" fill="#374151" font-size="9">Info / Reveal Slide</text>
        <line x1="20" y1="103" x2="30" y2="103" stroke="#dc2626" stroke-width="1" stroke-dasharray="3,2"></line>
        <text x="36" y="107" fill="#374151" font-size="9">Layer / Try Again</text>
      </svg>
    </div>
  </div>

  <!-- AIDA Slide Outline -->
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        Instructional Arc
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">10 Slides. AIDA Structure.</h2>
      <p class="text-lg text-muted mt-4 max-w-2xl mx-auto">
        Each slide maps to a deliberate phase of the AIDA model — moving the learner from hooked to invested to capable.
      </p>
    </div>
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm">
      <table class="w-full text-sm text-left">
        <thead>
          <tr class="bg-purple-900 text-white">
            <th class="px-4 py-3 font-semibold w-10">#</th>
