---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import YouTubeEmbed from '~/components/widgets/YouTubeEmbed.astro';

const metadata = {
  title: 'Technical Expert — Chegg Skills (Thinkful)',
};
---

<Layout metadata={metadata}>
  <Hero tagline="1:1 Student Support · Code Review · Thinkful">
    <Fragment slot="title">
      Technical Expert —<br />
      <span class="text-accent dark:text-white">Chegg Skills (Thinkful)</span>
    </Fragment>
    <Fragment slot="subtitle">
      Conducted one-on-one technical support sessions for career-changing students in Thinkful's Engineering Immersion
      prep program — reviewing HTML/CSS portfolio submissions, providing graded feedback, and live-coaching JavaScript
      coding challenges on Qualified.io.
    </Fragment>
  </Hero>

  <!-- Context -->
  <Content tagline="The Role" title="One-on-one support at the hardest moment" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12">
        <div class="text-center">
          <p class="text-8xl font-bold font-heading text-accent leading-none">1:1</p>
          <p class="text-xl text-muted mt-3">live student sessions</p>
          <div class="mt-8 space-y-2 text-sm text-muted">
            <p class="font-semibold text-gray-700 dark:text-gray-300">Chegg Skills (Thinkful)</p>
            <p>Technical Expert</p>
            <p>Engineering Immersion Prep</p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        Thinkful — acquired by Chegg — offered intensive bootcamp-style programs for adults changing careers into
        software engineering. As a Technical Expert, I supported students enrolled in the <em
          >Prep Course for Engineering Immersion</em
        >, meeting one-on-one via Zoom to review their project submissions and troubleshoot technical challenges in real
        time.
      </p>
      <p class="mb-4">
        The prep phase is where many career-changers hit their first real wall — concepts like the box model, GitHub,
        and web deployment feel abstract until you're actually debugging a broken layout at 11pm. My job was to be the
        expert on the other side of that moment.
      </p>
      <p>
        Sessions involved reviewing student-submitted GitHub repositories, walking through live code in the browser,
        writing structured graded feedback, and helping students understand not just what was wrong but why — so they
        could apply that thinking independently going forward.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- What I Did -->
  <Features3
    tagline="The Work"
    title="What Technical Expert sessions looked like"
    subtitle="A consistent cycle of review, feedback, and guided problem-solving across HTML, CSS, and web development fundamentals."
    columns={3}
    items={[
      {
        title: 'GitHub Repository Review',
        description:
          "Opened each student's submitted GitHub repo, reviewed their code structure and commit history, and pulled up the live deployed site to evaluate against project requirements.",
        icon: 'tabler:brand-github',
      },
      {
        title: 'Graded Written Feedback',
        description:
          'Provided structured written evaluations through the Thinkful platform — assessing whether projects met technical and content requirements, and adding specific, actionable improvement notes.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Live Zoom Walkthroughs',
        description:
          "Shared screens with students to walk through their submissions in real time — showing exactly where and why something wasn't working, and demonstrating how to approach fixing it.",
        icon: 'tabler:video',
      },
      {
        title: 'HTML & CSS Fundamentals',
        description:
          'Covered the core technical content of the prep curriculum: semantic HTML, CSS basics, the box model, web page templates, links and paths, and GitHub as a deployment tool.',
        icon: 'tabler:code',
      },
      {
        title: 'Portfolio Project Review',
        description:
          'Evaluated portfolio web pages for technical accuracy, layout quality, and requirement completion — guiding students through revision cycles until their work met the bar for the full program.',
        icon: 'tabler:layout',
      },
      {
        title: 'JavaScript Assessment Coaching',
        description:
          'Guided students through live JavaScript coding challenges on Qualified.io — working through logic problems like array iteration, conditionals, and object property access in real time while the student drove the keyboard.',
        icon: 'tabler:brand-javascript',
      },
      {
        title: 'Revision Guidance',
        description:
          "When students submitted work that didn't yet meet requirements, helped them understand the gaps and create a clear plan for revision — turning failure into a learning moment rather than a discouragement.",
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Session Example -->
  <Content tagline="In a Session" title="Reviewing a portfolio submission">
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12 px-6">
        <div class="w-full space-y-4">
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-5 border border-gray-200 dark:border-gray-700">
            <p class="text-xs font-semibold text-muted uppercase tracking-wide mb-2">
              Thinkful Platform — Grader Feedback
            </p>
            <p class="font-semibold text-gray-800 dark:text-gray-200 mb-2">
              Evaluate whether the student met the technical and content requirements for this project.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400 italic">
              "Dear Joshua, you have put in a great effort to work on this project. Met all the technical and content
              requirements for this project."
            </p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-5 border border-gray-200 dark:border-gray-700">
            <p class="text-xs font-semibold text-muted uppercase tracking-wide mb-2">Additional Feedback</p>
            <p class="text-sm text-gray-600 dark:text-gray-400 italic">
              "Prior to submitting, consider going through your app a few times. With each pass, try focusing on a
              specific requirement, verifying that it is met. This is a common practice amongst developers."
            </p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        A typical session began by opening the student's submitted GitHub repository alongside the live deployed site —
        reviewing the code and the rendered output simultaneously, the same way a developer would approach a code review
        at work.
      </p>
      <p class="mb-4">
        Feedback was both written and verbal. The structured written evaluation — submitted through the Thinkful
        platform — gave students a permanent reference. The live Zoom session made the feedback immediate and personal,
        turning abstract comments into concrete, visible changes.
      </p>
      <p>
        The feedback above is from an actual session: a student who put in genuine effort on their portfolio, met
        requirements, but needed guidance on systematic self-review — a skill as important as any technical concept in
        the curriculum.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-e"></div>
    </Fragment>
  </Content>

  <!-- Session Walkthrough -->
  <Content tagline="Session Walkthrough" title="How a 1:1 actually unfolds" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12 px-6">
        <div class="w-full max-w-sm space-y-3">
          {
            [
              {
                step: '01',
                label: 'Check In',
                detail: "Ask where Joshua is · what he's working on · what's blocking him",
              },
              {
                step: '02',
                label: 'Chrome DevTools',
                detail: 'Switch DevTools to dark theme together · surface the settings panel for future reference',
              },
              {
                step: '03',
                label: 'Git Config',
                detail:
                  'Set git config --global user.name and user.email · explain why it matters for commit attribution',
              },
              {
                step: '04',
                label: 'GitHub Config',
                detail:
                  'Confirm the existing GitHub account · run git config --global user.name and user.email · verify with git config --list',
              },
              {
                step: '05',
                label: 'git clone',
                detail: 'Clone a repository · walk through what the command does and where files land locally',
              },
              {
                step: '06',
                label: 'Terminal Navigation',
                detail: 'pwd · ls · cd — give Joshua a mental map of the filesystem so he can find his cloned files',
              },
            ].map((item) => (
              <div class="flex items-start gap-4 p-3 rounded-lg border border-gray-200 dark:border-gray-700">
                <span class="text-accent font-bold font-heading text-lg leading-none">{item.step}</span>
                <div>
                  <p class="font-semibold text-sm text-gray-800 dark:text-gray-200">{item.label}</p>
                  <p class="text-xs text-muted mt-0.5">{item.detail}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        The March 7 session is a good example of how unpredictable 1:1 support work actually is. Joshua came in needing
        help with Git — a foundational tool the curriculum assumed was already set up. It wasn't. Before any code review
        or assessment coaching could happen, the environment had to exist.
      </p>
      <p class="mb-4">
        That's not a detour. That's the session. Getting the tooling right — git config, GitHub account, a cloned
        repository, a mental model of the terminal — is what makes everything else in the curriculum possible. Skipping
        it doesn't make a student more ready; it just defers the confusion.
      </p>
      <p class="mb-4">
        The Chrome DevTools moment at the start was small but intentional. Switching to dark theme isn't a technical
        requirement — but taking a minute to show Joshua where the settings panel lives, and what else is configurable
        there, reinforced that DevTools is a workspace, not just a console. That framing pays off later.
      </p>
      <p>
        By the end of the session Joshua had a working Git setup, a cloned repository on his machine, and enough
        terminal fluency to navigate to it. From there, the actual project work could begin.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- Session Walkthrough Video -->
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-8">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        Session Recording
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Watch the Walkthrough</h2>
      <p class="text-lg text-muted mt-4">
        Git setup and DevTools walkthrough — a recorded 1:1 Technical Expert session from the Thinkful Engineering
        Immersion Prep program.
      </p>
    </div>
    <YouTubeEmbed id="IT-0RH_gg1A" title="Git Setup and DevTools Walkthrough — 1:1 Thinkful Technical Expert Session" />
  </div>

  <!-- JavaScript Assessment -->
  <Content tagline="JavaScript Assessment" title="Live coding on Qualified.io" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full px-6 py-8">
        <div class="w-full bg-gray-900 rounded-lg shadow-md border border-gray-700 p-5 font-mono text-sm">
          <p class="text-gray-500 mb-3 text-xs">solution.js — Qualified.io Assessment</p>
          <p class="text-gray-400">
            <span class="text-blue-400">function</span>
            <span class="text-yellow-300">campsiteCount</span>(<span class="text-orange-300">campgrounds</span>) {'{'}
          </p>
          <p class="text-gray-400 pl-4">
            <span class="text-blue-400">let</span> sum = <span class="text-green-400">0</span>
          </p>
          <p class="text-gray-400 pl-4">
            <span class="text-blue-400">for</span> (<span class="text-blue-400">let</span> i = <span
              class="text-green-400">0</span
            >; i &lt; campgrounds.length; i++) {'{'}
          </p>
          <p class="text-gray-400 pl-8">
            <span class="text-blue-400">if</span> (campgrounds[i].<span class="text-yellow-300">isReserved</span>) {'{'}
          </p>
          <p class="text-gray-400 pl-12">sum += campgrounds[i].<span class="text-yellow-300">partySize</span></p>
          <p class="text-gray-400 pl-8">{'}'}</p>
          <p class="text-gray-400 pl-4">{'}'}</p>
          <p class="text-gray-400 pl-4"><span class="text-blue-400">return</span> sum</p>
          <p class="text-gray-400">{'}'}</p>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        The second half of each session often shifted into JavaScript — working through coding challenges on
        Qualified.io, a browser-based assessment platform used by Thinkful to evaluate students' readiness for the full
        engineering program.
      </p>
      <p class="mb-4">
        In the session recorded here, the student was working through a <code
          class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">campsiteCount</code
        > challenge: iterate through an array of campground objects and sum the <code
          class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">partySize</code
        > for any campground where <code class="bg-gray-100 dark:bg-gray-800 px-1 rounded text-sm">isReserved</code> is true.
      </p>
      <p>
        The student had the loop structure right but hadn't yet connected the conditional. My role was to ask the right
        questions — "what property tells you whether a site is reserved?" — rather than just typing the answer, so the
        student arrived at the solution through their own reasoning.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-d"></div>
    </Fragment>
  </Content>

  <!-- Video -->
  <div class="max-w-4xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-8">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        Session Recording
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">See a Live Session</h2>
      <p class="text-lg text-muted mt-4">
        A recorded one-on-one Technical Expert session reviewing an HTML & CSS portfolio submission on the Thinkful
        platform, October 2022.
      </p>
    </div>
    <YouTubeEmbed
      id="QdBfCMiaUpY"
      title="Technical Expert Session — HTML & CSS Portfolio Review, Chegg Skills (Thinkful)"
    />
  </div>

  <!-- More Sessions -->
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">More Sessions</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">More from the Role</h2>
      <p class="text-lg text-muted mt-4">
        A growing collection of recorded 1:1 sessions — technical walkthroughs, coaching conversations, and live
        problem-solving from the Thinkful Engineering Immersion Prep program.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        [
          {
            id: 'IT-0RH_gg1A',
            type: 'Technical',
            typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
            title: 'Git Setup & DevTools Walkthrough',
            description:
              'Chrome DevTools dark theme, git config setup, terminal navigation — working through the tooling that the curriculum assumed was already in place.',
          },
          {
            id: '8ctHJsPHJPI',
            type: 'Coaching',
            typeColor: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
            title: 'Pre-Assessment Debrief',
            description:
              'Student completed the JavaScript take-home in an hour. Session shifted to program overview, early exit patterns, ES6 preview, and strategy for the gap before the December cohort.',
          },
          {
            id: 'yCdyMUm9uFM',
            type: 'Technical',
            typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
            title: 'Terminal Fundamentals: Filesystem Navigation & Unix Commands',
            description:
              'Core terminal skills from scratch — navigating with pwd, ls, and cd, then creating and organizing files using mkdir, touch, cp, and mv. Includes the -R recursive flag and when to use it.',
          },
          {
            id: 'wDZ0r0OVWZU',
            type: 'Technical',
            typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
            title: 'VS Code Debugger Troubleshooting: Run & Debug with Node.js',
            description:
              "Live troubleshooting when the VS Code debugger wouldn't show the Node.js environment selector. Covers the debug panel, JavaScript vs. Node.js debug terminal, and an alternative workflow using Live Server + Chrome DevTools with breakpoints.",
          },
          {
            id: 'Cs5r5mmTi70',
            type: 'Coaching',
            typeColor: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
            title: 'HTML Revision Debrief & Campgrounds Challenge: Accumulator Pattern on Qualified.io',
            description:
              'Reviewed a rejected HTML revision — identified it as a link mix-up, not a code issue — then walked through the evaluation structure before working the campgroundCapacity challenge live on Qualified.io. Covers accumulator pattern, isReserved conditionals, and the habit of reading problem instructions before writing code.',
          },
          {
            id: '_-l_H577SCY',
            type: 'Technical',
            typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
            title: 'CSS Flexbox Portfolio Review: Layout, Image Sizing & GitHub Pages',
            description:
              'Reviewed a submitted CSS/Flexbox portfolio project — covering flexbox vs. HTML tables, wrapping images in div containers for better sizing control, and using max-width/max-height together to maintain circular image proportions. Student successfully pushed to GitHub Pages from terminal using git.',
          },
          {
            id: 'X_EIuFFDH_w',
            type: 'Technical',
            typeColor: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
            title: 'JavaScript Plagiarism Checker: Bracket Notation & `.includes()` on Array of Objects',
            description:
              'Debugged a JavaScript plagiarism detection function — working through why `.push()` fails on an object, how to access nested string properties with bracket notation (`answers[i].response`), and using `.includes(checkText)` to detect matching text. Includes a conversation on the 20–30 minute debugging limit before reaching out for help.',
          },
        ].map((session) => (
          <button
            data-video-id={session.id}
            class="group session-card text-left flex flex-col p-6 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-accent dark:hover:border-accent transition-colors cursor-pointer w-full"
          >
            <div class="flex items-center justify-between mb-4">
              <span class={`text-xs font-semibold px-3 py-1 rounded-full ${session.typeColor}`}>{session.type}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-muted group-hover:text-accent transition-colors"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" />
              </svg>
            </div>
            <p class="font-semibold text-gray-800 dark:text-gray-200 mb-2 group-hover:text-accent transition-colors">
              {session.title}
            </p>
            <p class="text-sm text-muted leading-relaxed">{session.description}</p>
            <p class="text-xs text-accent mt-4 font-medium">Watch Session →</p>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Video Modal -->
  <div
    id="session-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Session video"
  >
    <div class="relative w-full max-w-4xl">
      <button
        id="modal-close"
        class="absolute -top-10 right-0 flex items-center gap-2 text-white/80 hover:text-white text-sm font-medium transition-colors"
        aria-label="Close video"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
        Close
      </button>
      <div class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl">
        <iframe
          id="modal-iframe"
          src=""
          class="w-full h-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>

  <script>
    function initSessionModal() {
      const modal = document.getElementById('session-modal');
      const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
      const closeBtn = document.getElementById('modal-close');

      function openModal(videoId: string) {
        if (!modal || !iframe) return;
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal || !iframe) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        iframe.src = '';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.session-card').forEach((btn) => {
        btn.addEventListener('click', () => {
          const videoId = btn.getAttribute('data-video-id');
          if (videoId) openModal(videoId);
        });
      });

      closeBtn?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    }

    document.addEventListener('astro:page-load', initSessionModal);
  </script>

  <!-- Reflection -->
  <Content tagline="Reflection" title="Feedback as a teaching tool" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12">
        <div class="text-center">
          <p class="text-8xl font-bold font-heading text-accent leading-none">2022</p>
          <p class="text-xl text-muted mt-3">Chegg Skills (Thinkful)</p>
          <div class="mt-8 space-y-2 text-sm text-muted">
            <p class="font-semibold text-gray-700 dark:text-gray-300">Technical Expert</p>
            <p>1:1 Student Sessions · Code Review</p>
            <p>Engineering Immersion Prep</p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        The Technical Expert role refined something I'd been developing across years of bootcamp and online instruction:
        the ability to write feedback that teaches, not just evaluates.
      </p>
      <p class="mb-4">
        Good feedback tells a student what to fix. Great feedback explains the principle behind the fix — so the next
        time they encounter a similar problem, they have a framework for solving it themselves. That's what I tried to
        deliver in every written evaluation and every live session.
      </p>
      <p class="mb-4">
        It's the same principle that drives good instructional design: the goal isn't to answer the question in front of
        you, it's to build the learner's capacity to answer the next one on their own.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          [
            'HTML',
            'CSS',
            'GitHub',
            'Code Review',
            '1:1 Instruction',
            'Thinkful',
            'Chegg Skills',
            'Technical Feedback',
          ].map((tag) => (
            <span class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm font-medium px-3 py-1 rounded-full">
              {tag}
            </span>
          ))
        }
      </div>
      <p class="text-sm text-muted mt-4">Technical Expert, Chegg Skills (Thinkful), 2022.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'View All Projects', href: '/projects' },
      { text: 'Get in Touch', href: '/about#contact' },
    ]}
  >
    <Fragment slot="title">Interested in working together?</Fragment>
    <Fragment slot="subtitle"
      >I'm open to remote opportunities in instructional design and technical learning experience design.</Fragment
    >
  </CallToAction>
</Layout>
