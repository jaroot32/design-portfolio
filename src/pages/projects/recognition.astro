---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import springboardCard from '~/assets/images/springboard-recognition.webp';
import { Image } from 'astro:assets';

const metadata = {
  title: 'Recognition — Jonathan Root',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Mentorship · Teaching · Recognition">
    <Fragment slot="title">
      Recognition &<br />
      <span class="text-accent dark:text-white">Peer Feedback</span>
    </Fragment>
    <Fragment slot="subtitle">
      Recognition received from EdTech platforms, students, and peers across eight years of mentorship and technical
      instruction.
    </Fragment>
  </Hero>

  <!-- Springboard -->
  <Content tagline="Springboard" title="Recognized for COVID-19 Scholarship contribution" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full px-6 py-8">
        <Image
          src={springboardCard}
          alt="Springboard COVID-19 Scholarship recognition — handwritten card and Moleskine notebook gift"
          class="w-full rounded-lg shadow-md border border-gray-200 dark:border-gray-700"
        />
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        During the COVID-19 pandemic, Springboard sent a handwritten card and Moleskine notebook in recognition of my
        contribution to their COVID-19 Scholarship — a program that funded access to Springboard's programs for students
        in financial need affected by the pandemic.
      </p>
      <blockquote class="border-l-4 border-accent pl-4 my-4">
        <p class="text-gray-700 dark:text-gray-300 italic">
          "On behalf of Springboard, we want to thank you for your generous contribution to the COVID-19 Scholarship.
          With your help, we're able to impact the lives of students in need who are affected by the pandemic. We
          greatly appreciate your willingness to step up during this challenging time."
        </p>
        <footer class="text-sm text-muted mt-2">— Springboard Mentor Community</footer>
      </blockquote>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- Chegg -->
  <Content tagline="Chegg Skills" title="Recognition from Chegg">
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full px-6 py-8">
        <p class="text-muted italic text-center">[ Chegg recognition — coming soon ]</p>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">Placeholder for Chegg recognition content.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-e"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'View All Projects', href: '/projects' },
      { text: 'Get in Touch', href: '/about#contact' },
    ]}
  >
    <Fragment slot="title">Interested in working together?</Fragment>
    <Fragment slot="subtitle"
      >I'm currently available for remote instructional design and eLearning development contracts.</Fragment
    >
  </CallToAction>
</Layout>
