---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'JavaScript & xAPI for eLearning',
};
---

<style is:global>
  @media (min-width: 768px) {
    #overview-section .md\:flex {
      display: flex !important;
      flex-direction: column !important;
    }
    #rise-section .md\:flex {
      display: flex !important;
      flex-direction: column !important;
    }
  }
</style>

<Layout metadata={metadata}>
  <Hero tagline="Instructional Design · Graduate Certificate Capstone">
    <Fragment slot="title">
      JavaScript & xAPI<br />
      <span class="text-accent dark:text-white">for Interactive eLearning</span>
    </Fragment>
    <Fragment slot="subtitle">
      A fully designed and deployed mini-course equipping eLearning professionals with the skills to extend authoring tools with JavaScript and capture rich learner data using xAPI.
    </Fragment>
  </Hero>

  <!-- Project Overview -->
  <Content
    id="overview-section"
    tagline="Overview"
    title="The Project"
    subtitle="Many eLearning developers are proficient in authoring tools but lack the programming skills to create truly customized, data-rich experiences. This course addresses that gap — providing a practical introduction to JavaScript and xAPI that empowers eLearning professionals to extend their tools and gain deeper insight into learner behavior."
    columns={2}
    items={[
      { title: 'Type', description: 'Mini-course — capstone for Graduate Certificate in Learning Design & Technology' },
      { title: 'Tools', description: 'Articulate Rise 360 · Canvas LMS' },
      { title: 'Role', description: 'Instructional Designer & Subject Matter Expert' },
      { title: 'Modality', description: 'Fully online, asynchronous with optional peer community' },
      { title: 'Live Course', description: 'Hosted in Canvas LMS with Rise 360 assessments (available on request)' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Course Features -->
  <Features2
    tagline="Course Design"
    title="Key Course Features"
    subtitle="Designed for busy eLearning professionals who need practical, immediately applicable skills."
    columns={2}
    items={[
      {
        title: 'Interactive Coding Exercises',
        description: 'Hands-on coding challenges embedded directly in the course, with real-time feedback to reinforce learning and immediate application of JavaScript concepts.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'Scenario-Based Learning Projects',
        description: 'Mini-projects simulating real eLearning development scenarios — building a quiz, tracking learner progress with xAPI — allowing practice in authentic contexts.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Multimedia Explanations',
        description: 'Key concepts delivered through short videos, narrated animations, and annotated visuals, ensuring accessibility across different learning preferences.',
        icon: 'tabler:video',
      },
      {
        title: 'Built-In Knowledge Checks',
        description: 'Frequent low-stakes quizzes and reflection prompts help learners self-assess their understanding before moving to the next concept.',
        icon: 'tabler:checklist',
      },
    ]}
  />

  <!-- LMS & Tools -->
  <Content
    id="rise-section"
    tagline="Platform Choice"
    title="Why Articulate Rise 360"
    isReversed
    items={[
      {
        title: 'Interactive Blocks',
        description: 'Drag-and-drop, matching, sorting, and quiz activities without custom coding — ideal for a course teaching coding concepts to non-programmers.',
      },
      {
        title: 'SCORM / xAPI Export',
        description: 'Exports directly to SCORM or xAPI formats, enabling real-world tracking of learner performance in an LRS — mirroring exactly what the course teaches.',
      },
      {
        title: 'Responsive Design',
        description: 'Automatically adapts to desktop, tablet, and mobile, ensuring accessibility regardless of device.',
      },
      {
        title: 'Seamless LMS Integration',
        description: 'Deployed within Canvas LMS for grading, discussions, rubrics, and peer engagement alongside the Rise content.',
      },
    ]}
  >
    <Fragment slot="content">
      Rise 360 was selected because it directly mirrors the course content — a platform that exports xAPI data is the ideal environment for teaching learners how xAPI works.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Target Audience -->
  <Features3
    tagline="Target Audience"
    title="Who This Course Is For"
    subtitle="Adult learners ages 25–55 working in instructional design, eLearning development, or training — with foundational authoring tool experience and a desire to expand their technical skill set."
    columns={3}
    items={[
      {
        title: 'Instructional Designers',
        description: 'Seeking to move beyond standard authoring tool limitations and create custom, dynamic interactions.',
        icon: 'tabler:pencil',
      },
      {
        title: 'eLearning Developers',
        description: 'Looking to capture richer learner data and build more personalized experiences through xAPI.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Training Professionals',
        description: 'Interested in moving beyond completion metrics to track meaningful learner behavior and outcomes.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Design Process -->
  <Steps
    tagline="Design Process"
    title="ADDIE in Practice"
    subtitle="The course was developed using the ADDIE model, with constructivist and andragogical principles shaping every phase."
    items={[
      {
        title: 'Analysis',
        description: 'Identified a clear skills gap: eLearning professionals are proficient in authoring tools but lack the programming knowledge to create custom interactions or capture detailed learner data. Defined a detailed target audience profile across demographics, prior knowledge, technical aptitude, and motivation.',
        icon: 'tabler:search',
      },
      {
        title: 'Design',
        description: 'Mapped six measurable Course Learning Outcomes (CLOs) using Bloom\'s Taxonomy action verbs. Designed a three-module course structure — JavaScript Basics, DOM Manipulation, and xAPI Statements — with each module\'s objectives directly aligned to CLOs. Selected Rise 360 + Canvas as the delivery platform.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Development',
        description: 'Built course content in Rise 360 and Canvas, including tutorial videos, an interactive coding sandbox, a 10-question mixed-format assessment, discussion prompts, a major assignment with a detailed rubric, and a full course syllabus. Applied accessibility standards and cognitive load principles throughout.',
        icon: 'tabler:code',
      },
      {
        title: 'Implementation',
        description: 'Piloted activities using a demo student account to verify functionality. Published the Rise 360 assessment with immediate feedback on each question. Configured Canvas with grading rubrics, participation requirements, and a clear schedule of instructional events.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Evaluation',
        description: 'Designed a Kirkpatrick Level 1 survey (learner reactions via Typeform) and a Kirkpatrick Level 2 assessment (knowledge and skill mastery via Rise 360) to measure effectiveness and inform continuous improvement.',
        icon: 'tabler:chart-dots',
      },
    ]}
  />

  <!-- CLOs -->
  <Features3
    tagline="Course Learning Outcomes"
    title="By the end of this course, learners will be able to:"
    columns={2}
    items={[
      {
        title: 'Apply JavaScript fundamentals',
        description: 'Use core JavaScript concepts — variables, functions, conditionals, loops — in eLearning design contexts.',
        icon: 'tabler:check',
      },
      {
        title: 'Manipulate the DOM',
        description: 'Dynamically modify eLearning content and UI elements using JavaScript in response to learner actions.',
        icon: 'tabler:check',
      },
      {
        title: 'Construct valid xAPI statements',
        description: 'Accurately capture a range of learner interactions using proper Actor, Verb, and Object structure.',
        icon: 'tabler:check',
      },
      {
        title: 'Integrate JavaScript and xAPI',
        description: 'Send xAPI statements to a Learning Record Store (LRS) from web-based eLearning content.',
        icon: 'tabler:check',
      },
      {
        title: 'Evaluate xAPI applications',
        description: 'Assess the potential of JavaScript and xAPI to address specific challenges and enhance data collection across scenarios.',
        icon: 'tabler:check',
      },
      {
        title: 'Collaborate and reflect',
        description: 'Engage with peers to analyze and reflect on the role of code in instructional design through discussion and peer review.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Design Document -->
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-12">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Design Document</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading mb-4">8-Week Course Design Process</h2>
      <p class="text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">Developing this instructional design document taught me how to plan a course from the ground up — aligning objectives with measurable outcomes and ensuring every instructional choice supports learner needs. This process gave me a deeper understanding of how structure and strategy transform a concept into a complete learning experience.</p>
    </div>

    <div class="space-y-6 max-w-4xl mx-auto">
      {[
        {
          week: 'Week 1',
          title: 'Mini-course Topic',
          content: 'Identified the core knowledge gap: eLearning professionals need JavaScript and xAPI skills to extend authoring tools and capture richer learning data. Defined the course premise — bridging the gap between JavaScript skills and xAPI understanding for eLearning professionals.'
        },
        {
          week: 'Week 2',
          title: 'Target Audience Analysis',
          content: 'Developed a detailed learner profile: instructional designers, eLearning developers, and training professionals ages 25–55. Analyzed demographics, prior knowledge (authoring tools, basic HTML/CSS), technical aptitude, pain points, and learning goals. Concluded the ideal learner is a proactive eLearning professional seeking practical, immediately applicable skills.'
        },
        {
          week: 'Week 3',
          title: 'Course Type & Modality',
          content: 'Selected a blended, practical application-focused course type combining asynchronous online modules with collaborative activities. Chose a primarily online, asynchronous modality with an optional Discord community — providing flexibility for working professionals while enabling peer support and resource sharing.'
        },
        {
          week: 'Week 4',
          title: 'Course Learning Outcomes (v1)',
          content: 'Drafted six initial CLOs using Bloom\'s Taxonomy. Focused on applying JavaScript syntax, manipulating the DOM, constructing xAPI statements, sending data to an LRS, identifying use cases, and integrating both technologies into eLearning content.'
        },
        {
          week: 'Week 5',
          title: 'Learning Activities',
          content: 'Designed six learning activities: interactive code-along sessions, xAPI statement construction challenges, "Track This Interaction" mini-projects, case study analysis, integration brainstorms, and peer code review. Each activity was aligned to specific CLOs to ensure instructional coherence.'
        },
        {
          week: 'Week 6',
          title: 'Instructional Design Model',
          content: 'Selected a hybrid RID + SAM model over pure ADDIE — leveraging RID for rapid prototyping and early learner engagement, and SAM for iterative refinement based on stakeholder feedback. This combination balanced speed, structure, and continuous improvement for a technical skills course.'
        },
        {
          week: 'Week 7',
          title: 'CLO Revision & Module Objectives',
          content: 'Revised all six CLOs with stronger Bloom\'s action verbs (implement, manipulate, construct, integrate, evaluate, develop) and greater specificity. Designed Module 1 learning objectives aligned to CLOs 1 and 2, with six detailed module-level objectives covering JavaScript fundamentals and DOM manipulation. Identified SMEs and key resources: MDN Web Docs, xAPI Specification (ADL), and Articulate E-Learning Heroes.'
        },
        {
          week: 'Week 8',
          title: 'Signature Assignment — Complete IDD',
          content: 'Synthesized all prior work into a complete Instructional Design Document including course overview, knowledge gap analysis, target audience profile, course type and modality rationale, final CLOs, module objectives, learning activities, assessment strategies, SME resources, ADDIE model application, and learning theory framework (Constructivism + Cognitive Load Theory).'
        },
      ].map((item, i) => (
        <div class="flex gap-6 items-start">
          <div class="flex-shrink-0 w-24 text-right">
            <span class="text-sm font-bold text-secondary dark:text-blue-300 uppercase tracking-wide">{item.week}</span>
          </div>
          <div class="flex-shrink-0 flex flex-col items-center">
            <div class="w-4 h-4 rounded-full bg-primary mt-1"></div>
            {i < 7 && <div class="w-0.5 bg-slate-200 dark:bg-slate-700 flex-1 mt-1" style="min-height: 3rem;"></div>}
          </div>
          <div class="pb-8">
            <h3 class="text-lg font-bold font-heading mb-1">{item.title}</h3>
            <p class="text-muted dark:text-slate-300">{item.content}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Evaluation Strategy -->
  <Content
    tagline="Evaluation"
    title="Measuring Learning Effectiveness"
    items={[
      {
        title: 'Kirkpatrick Level 1 — Learner Reactions',
        description: 'A Typeform survey measuring satisfaction, engagement, and perceived CLO achievement using a mix of Likert scales, multiple choice, and open-ended questions.',
      },
      {
        title: 'Kirkpatrick Level 2 — Knowledge & Skill Mastery',
        description: 'A 10-question Rise 360 assessment using multiple choice, true/false, fill-in-the-blank, and drag-and-drop questions. Passing score: 70%. Unlimited attempts. Immediate feedback on every question.',
      },
      {
        title: 'Discussion Rubrics',
        description: 'Evaluated across 5 criteria — topic knowledge, critical thinking, peer engagement, writing mechanics, and timeliness — with weighted scoring to emphasize content over compliance.',
      },
      {
        title: 'Assignment Rubric',
        description: 'xAPI statement assignment scored on accuracy, explanation depth, eLearning application relevance, organization, and submission quality.',
      },
    ]}
  >
    <Fragment slot="content">
      Assessment was designed to close the loop between learning objectives and measurable outcomes. Each instrument generates data that can directly inform course redesign — not just a grade.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Videos -->
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Course Media</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Videos</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold mb-3">Minicourse Introduction</h3>
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full rounded-lg shadow-lg"
            src="https://www.youtube.com/embed/sT9QCXRi2fs"
            title="JavaScript & xAPI for eLearning — Minicourse Introduction"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-3">Screencast Demo</h3>
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full rounded-lg shadow-lg"
            src="https://www.youtube.com/embed/P1s90dVsLhU"
            title="JavaScript & xAPI for eLearning — Screencast Demo"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <p class="text-sm text-muted mt-2">Licensed under CC BY 4.0</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-3">Module 2 Presentation</h3>
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full rounded-lg shadow-lg"
            src="https://www.youtube.com/embed/zP_PO717tYQ"
            title="JavaScript & xAPI for eLearning — Module 2 Presentation"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-3">Capstone Mini-course Presentation</h3>
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            class="absolute inset-0 w-full h-full rounded-lg shadow-lg"
            src="https://www.youtube.com/embed/N9855IeKoK4"
            title="JavaScript & xAPI for eLearning — Capstone Mini-course Presentation"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Live Links -->
  <Features2
    tagline="Live Work"
    title="See the Course in Action"
    columns={2}
    items={[
      {
        title: 'Rise 360 Interactive Module',
        description: 'An interactive Rise 360 module covering JavaScript and xAPI fundamentals. Link will be added once the module is re-published.',
        icon: 'tabler:external-link',
      },
      {
        title: 'Canvas Course (Temporarily Unavailable)',
        description: 'The full course — including discussions, assignments, syllabus, and rubrics — was hosted in Canvas LMS. Canvas Free-for-Teacher is currently offline due to a platform-wide security incident. Access will be restored when the platform comes back online.',
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Learning Theory -->
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-12">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Design Rationale</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading mb-4">Learning Theory & Approach</h2>
      <p class="text-xl text-muted dark:text-slate-300 max-w-3xl mx-auto">Two theories — Constructivism and Connectivism — shaped the instructional design decisions for this course, each addressing a different dimension of how technical skills are best learned.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Constructivism -->
      <div class="bg-blue-50 dark:bg-slate-800 rounded-xl p-8">
        <h3 class="text-2xl font-bold font-heading mb-2">Constructivism</h3>
        <p class="text-muted dark:text-slate-300 mb-6">Learners build knowledge actively through doing, not passive reception — directly aligned with the hands-on coding nature of this course.</p>

        <h4 class="font-semibold text-green-700 dark:text-green-400 mb-2">Strengths</h4>
        <ul class="space-y-2 mb-6 text-muted dark:text-slate-300">
          <li class="flex gap-2"><span class="text-green-600 mt-1">✓</span> <span><strong>Active learning:</strong> Learners write, test, and debug real code — leading to deeper retention and application.</span></li>
          <li class="flex gap-2"><span class="text-green-600 mt-1">✓</span> <span><strong>Problem-solving:</strong> Practical projects develop critical thinking essential for JavaScript and xAPI implementation.</span></li>
        </ul>

        <h4 class="font-semibold text-amber-700 dark:text-amber-400 mb-2">Limitations</h4>
        <ul class="space-y-2 mb-6 text-muted dark:text-slate-300">
          <li class="flex gap-2"><span class="text-amber-600 mt-1">△</span> <span><strong>Frustration risk:</strong> Coding can overwhelm beginners without adequate scaffolding and support.</span></li>
          <li class="flex gap-2"><span class="text-amber-600 mt-1">△</span> <span><strong>Time commitment:</strong> Constructivist learning requires significant practice time, which varies by learner.</span></li>
        </ul>

        <h4 class="font-semibold mb-2">Applied in This Course</h4>
        <ul class="space-y-1 text-muted dark:text-slate-300 text-sm">
          <li>→ Project-based weekly coding challenges building toward a final xAPI-enabled eLearning element</li>
          <li>→ Scaffolded exercises with templates and code snippets, reducing support as confidence grows</li>
          <li>→ Debugging challenges where learners fix broken code</li>
          <li>→ Peer code reviews and reflection journals</li>
        </ul>
      </div>

      <!-- Connectivism -->
      <div class="bg-blue-50 dark:bg-slate-800 rounded-xl p-8">
        <h3 class="text-2xl font-bold font-heading mb-2">Connectivism</h3>
        <p class="text-muted dark:text-slate-300 mb-6">Learning happens through networks and connections — particularly relevant for a field where knowledge is distributed across communities, documentation, and open-source resources.</p>

        <h4 class="font-semibold text-green-700 dark:text-green-400 mb-2">Strengths</h4>
        <ul class="space-y-2 mb-6 text-muted dark:text-slate-300">
          <li class="flex gap-2"><span class="text-green-600 mt-1">✓</span> <span><strong>Community learning:</strong> Online forums and peer collaboration extend learning beyond the course boundary.</span></li>
          <li class="flex gap-2"><span class="text-green-600 mt-1">✓</span> <span><strong>Real-world resources:</strong> Curated links to MDN, xAPI spec, and Articulate community connect learners to practitioner knowledge.</span></li>
        </ul>

        <h4 class="font-semibold text-amber-700 dark:text-amber-400 mb-2">Limitations</h4>
        <ul class="space-y-2 mb-6 text-muted dark:text-slate-300">
          <li class="flex gap-2"><span class="text-amber-600 mt-1">△</span> <span><strong>Information overload:</strong> Without curation, learners can become overwhelmed by the volume of available resources.</span></li>
          <li class="flex gap-2"><span class="text-amber-600 mt-1">△</span> <span><strong>Structure dependency:</strong> Learners without self-direction may struggle in loosely structured network environments.</span></li>
        </ul>

        <h4 class="font-semibold mb-2">Applied in This Course</h4>
        <ul class="space-y-1 text-muted dark:text-slate-300 text-sm">
          <li>→ Curated resource lists: MDN Web Docs, xAPI specification, Articulate E-Learning Heroes</li>
          <li>→ Optional Discord community for async peer discussion and resource sharing</li>
          <li>→ Resource sharing activities where learners find and contribute useful tools</li>
          <li>→ Guest speaker webinars with industry professionals</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 bg-slate-100 dark:bg-slate-800 rounded-xl p-8 max-w-3xl mx-auto text-center">
      <h4 class="font-bold text-lg mb-2">The Combination</h4>
      <p class="text-muted dark:text-slate-300">By scaffolding the constructivist portion and curating the connectivist portion, the course creates a dynamic learning environment that balances hands-on practice with access to community support and real-world resources — without leaving learners lost or overwhelmed.</p>
    </div>
  </div>

  <!-- Reflection -->
  <Content
    tagline="Reflection"
    title="What I Learned"
  >
    <Fragment slot="content">
      <p class="mb-4">Completing this capstone helped me integrate everything from the graduate certificate program into a cohesive design process — from learner analysis through deployed assessment. I gained practical experience aligning learning outcomes with assessments and media, applying accessibility standards, and designing data-driven evaluation using the Kirkpatrick framework.</p>
      <p class="mb-4">The most significant insight was how much design decisions — in structure, sequencing, and interaction format — directly impact learner engagement and outcomes. Choosing ADDIE as the overarching model gave the project discipline and alignment, while constructivist principles kept the learning active and contextually relevant.</p>
      <p class="mb-4">The biggest challenge was balancing technical complexity with accessibility. Some learners may be intimidated by JavaScript. Scaffolding content gradually — from simple variable declarations to full xAPI integration — and providing multiple question types and formats helped accommodate a range of prior experience levels.</p>
      <p>If I were to extend this course, I would add advanced modules covering live LRS integration and introduce peer code review as a formal assessed activity, not just an optional discussion prompt.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'View All Projects', href: '/projects' },
      { text: 'Get in Touch', href: '/about#contact' },
    ]}
  >
    <Fragment slot="title">Interested in working together?</Fragment>
    <Fragment slot="subtitle">I'm open to remote opportunities in instructional design and technical learning experience design.</Fragment>
  </CallToAction>
</Layout>
