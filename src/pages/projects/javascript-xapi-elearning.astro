---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'JavaScript & xAPI for eLearning',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Instructional Design · Graduate Certificate Capstone">
    <Fragment slot="title">
      JavaScript & xAPI<br />
      <span class="text-accent dark:text-white">for Interactive eLearning</span>
    </Fragment>
    <Fragment slot="subtitle">
      A fully designed and deployed mini-course equipping eLearning professionals with the skills to extend authoring tools with JavaScript and capture rich learner data using xAPI.
    </Fragment>
  </Hero>

  <!-- Project Overview -->
  <Content
    tagline="Overview"
    title="The Project"
    subtitle="Many eLearning developers are proficient in authoring tools but lack the programming skills to create truly customized, data-rich experiences. This course addresses that gap — providing a practical introduction to JavaScript and xAPI that empowers eLearning professionals to extend their tools and gain deeper insight into learner behavior."
    items={[
      { title: 'Type', description: 'Mini-course — capstone for Graduate Certificate in Learning Design & Technology' },
      { title: 'Tools', description: 'Articulate Rise 360 · Canvas LMS' },
      { title: 'Role', description: 'Instructional Designer & Subject Matter Expert' },
      { title: 'Modality', description: 'Fully online, asynchronous with optional peer community' },
      { title: 'Live Course', description: 'Hosted in Canvas LMS with Rise 360 assessments (available on request)' },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Course Features -->
  <Features2
    tagline="Course Design"
    title="Key Course Features"
    subtitle="Designed for busy eLearning professionals who need practical, immediately applicable skills."
    columns={2}
    items={[
      {
        title: 'Interactive Coding Exercises',
        description: 'Hands-on coding challenges embedded directly in the course, with real-time feedback to reinforce learning and immediate application of JavaScript concepts.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'Scenario-Based Learning Projects',
        description: 'Mini-projects simulating real eLearning development scenarios — building a quiz, tracking learner progress with xAPI — allowing practice in authentic contexts.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Multimedia Explanations',
        description: 'Key concepts delivered through short videos, narrated animations, and annotated visuals, ensuring accessibility across different learning preferences.',
        icon: 'tabler:video',
      },
      {
        title: 'Built-In Knowledge Checks',
        description: 'Frequent low-stakes quizzes and reflection prompts help learners self-assess their understanding before moving to the next concept.',
        icon: 'tabler:checklist',
      },
    ]}
  />

  <!-- LMS & Tools -->
  <Content
    tagline="Platform Choice"
    title="Why Articulate Rise 360"
    isReversed
    items={[
      {
        title: 'Interactive Blocks',
        description: 'Drag-and-drop, matching, sorting, and quiz activities without custom coding — ideal for a course teaching coding concepts to non-programmers.',
      },
      {
        title: 'SCORM / xAPI Export',
        description: 'Exports directly to SCORM or xAPI formats, enabling real-world tracking of learner performance in an LRS — mirroring exactly what the course teaches.',
      },
      {
        title: 'Responsive Design',
        description: 'Automatically adapts to desktop, tablet, and mobile, ensuring accessibility regardless of device.',
      },
      {
        title: 'Seamless LMS Integration',
        description: 'Deployed within Canvas LMS for grading, discussions, rubrics, and peer engagement alongside the Rise content.',
      },
    ]}
  >
    <Fragment slot="content">
      Rise 360 was selected because it directly mirrors the course content — a platform that exports xAPI data is the ideal environment for teaching learners how xAPI works.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Target Audience -->
  <Features3
    tagline="Target Audience"
    title="Who This Course Is For"
    subtitle="Adult learners ages 25–55 working in instructional design, eLearning development, or training — with foundational authoring tool experience and a desire to expand their technical skill set."
    columns={3}
    items={[
      {
        title: 'Instructional Designers',
        description: 'Seeking to move beyond standard authoring tool limitations and create custom, dynamic interactions.',
        icon: 'tabler:pencil',
      },
      {
        title: 'eLearning Developers',
        description: 'Looking to capture richer learner data and build more personalized experiences through xAPI.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Training Professionals',
        description: 'Interested in moving beyond completion metrics to track meaningful learner behavior and outcomes.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Design Process -->
  <Steps
    tagline="Design Process"
    title="ADDIE in Practice"
    subtitle="The course was developed using the ADDIE model, with constructivist and andragogical principles shaping every phase."
    items={[
      {
        title: 'Analysis',
        description: 'Identified a clear skills gap: eLearning professionals are proficient in authoring tools but lack the programming knowledge to create custom interactions or capture detailed learner data. Defined a detailed target audience profile across demographics, prior knowledge, technical aptitude, and motivation.',
        icon: 'tabler:search',
      },
      {
        title: 'Design',
        description: 'Mapped six measurable Course Learning Outcomes (CLOs) using Bloom\'s Taxonomy action verbs. Designed a three-module course structure — JavaScript Basics, DOM Manipulation, and xAPI Statements — with each module\'s objectives directly aligned to CLOs. Selected Rise 360 + Canvas as the delivery platform.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Development',
        description: 'Built course content in Rise 360 and Canvas, including tutorial videos, an interactive coding sandbox, a 10-question mixed-format assessment, discussion prompts, a major assignment with a detailed rubric, and a full course syllabus. Applied accessibility standards and cognitive load principles throughout.',
        icon: 'tabler:code',
      },
      {
        title: 'Implementation',
        description: 'Piloted activities using a demo student account to verify functionality. Published the Rise 360 assessment with immediate feedback on each question. Configured Canvas with grading rubrics, participation requirements, and a clear schedule of instructional events.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Evaluation',
        description: 'Designed a Kirkpatrick Level 1 survey (learner reactions via Typeform) and a Kirkpatrick Level 2 assessment (knowledge and skill mastery via Rise 360) to measure effectiveness and inform continuous improvement.',
        icon: 'tabler:chart-dots',
      },
    ]}
  />

  <!-- CLOs -->
  <Features3
    tagline="Course Learning Outcomes"
    title="By the end of this course, learners will be able to:"
    columns={2}
    items={[
      {
        title: 'Apply JavaScript fundamentals',
        description: 'Use core JavaScript concepts — variables, functions, conditionals, loops — in eLearning design contexts.',
        icon: 'tabler:check',
      },
      {
        title: 'Manipulate the DOM',
        description: 'Dynamically modify eLearning content and UI elements using JavaScript in response to learner actions.',
        icon: 'tabler:check',
      },
      {
        title: 'Construct valid xAPI statements',
        description: 'Accurately capture a range of learner interactions using proper Actor, Verb, and Object structure.',
        icon: 'tabler:check',
      },
      {
        title: 'Integrate JavaScript and xAPI',
        description: 'Send xAPI statements to a Learning Record Store (LRS) from web-based eLearning content.',
        icon: 'tabler:check',
      },
      {
        title: 'Evaluate xAPI applications',
        description: 'Assess the potential of JavaScript and xAPI to address specific challenges and enhance data collection across scenarios.',
        icon: 'tabler:check',
      },
      {
        title: 'Collaborate and reflect',
        description: 'Engage with peers to analyze and reflect on the role of code in instructional design through discussion and peer review.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Evaluation Strategy -->
  <Content
    tagline="Evaluation"
    title="Measuring Learning Effectiveness"
    items={[
      {
        title: 'Kirkpatrick Level 1 — Learner Reactions',
        description: 'A Typeform survey measuring satisfaction, engagement, and perceived CLO achievement using a mix of Likert scales, multiple choice, and open-ended questions.',
      },
      {
        title: 'Kirkpatrick Level 2 — Knowledge & Skill Mastery',
        description: 'A 10-question Rise 360 assessment using multiple choice, true/false, fill-in-the-blank, and drag-and-drop questions. Passing score: 70%. Unlimited attempts. Immediate feedback on every question.',
      },
      {
        title: 'Discussion Rubrics',
        description: 'Evaluated across 5 criteria — topic knowledge, critical thinking, peer engagement, writing mechanics, and timeliness — with weighted scoring to emphasize content over compliance.',
      },
      {
        title: 'Assignment Rubric',
        description: 'xAPI statement assignment scored on accuracy, explanation depth, eLearning application relevance, organization, and submission quality.',
      },
    ]}
  >
    <Fragment slot="content">
      Assessment was designed to close the loop between learning objectives and measurable outcomes. Each instrument generates data that can directly inform course redesign — not just a grade.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Live Links -->
  <Features2
    tagline="Live Work"
    title="See the Course in Action"
    columns={2}
    items={[
      {
        title: 'Rise 360 Assessment',
        description: 'View the Module 2 knowledge assessment — a 10-question mixed-format quiz covering DOM manipulation and xAPI statement construction.',
        icon: 'tabler:external-link',
        callToAction: {
          text: 'Open Assessment',
          href: 'https://rise.articulate.com/share/NGQs5TQzyVdIvP23bU4pSIjSDvUoWF7w',
          target: '_blank',
        },
      },
      {
        title: 'Canvas Course (Temporarily Unavailable)',
        description: 'The full course — including discussions, assignments, syllabus, and rubrics — was hosted in Canvas LMS. Canvas Free-for-Teacher is currently offline due to a platform-wide security incident. Access will be restored when the platform comes back online.',
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Learning Theory -->
  <Content
    tagline="Design Rationale"
    title="Learning Theory & Approach"
    isReversed
  >
    <Fragment slot="content">
      <p class="mb-4"><strong>Constructivism</strong> was the primary learning theory shaping this course. Rather than passively receiving information, learners build knowledge by doing — writing real JavaScript, constructing actual xAPI statements, and applying both to eLearning scenarios they recognize from their own work.</p>
      <p class="mb-4"><strong>Andragogy</strong> influenced the emphasis on relevance and autonomy. Discussion prompts connect technical concepts to each learner's professional context, and assignments encourage personal application rather than generic exercises.</p>
      <p><strong>Cognitive Load Theory</strong> guided the pacing and sequencing — breaking complex concepts into modular chunks, providing visual diagrams of xAPI anatomy, and scaffolding from simple DOM manipulation to full LRS integration across three modules.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Reflection -->
  <Content
    tagline="Reflection"
    title="What I Learned"
  >
    <Fragment slot="content">
      <p class="mb-4">Completing this capstone helped me integrate everything from the graduate certificate program into a cohesive design process — from learner analysis through deployed assessment. I gained practical experience aligning learning outcomes with assessments and media, applying accessibility standards, and designing data-driven evaluation using the Kirkpatrick framework.</p>
      <p class="mb-4">The most significant insight was how much design decisions — in structure, sequencing, and interaction format — directly impact learner engagement and outcomes. Choosing ADDIE as the overarching model gave the project discipline and alignment, while constructivist principles kept the learning active and contextually relevant.</p>
      <p class="mb-4">The biggest challenge was balancing technical complexity with accessibility. Some learners may be intimidated by JavaScript. Scaffolding content gradually — from simple variable declarations to full xAPI integration — and providing multiple question types and formats helped accommodate a range of prior experience levels.</p>
      <p>If I were to extend this course, I would add advanced modules covering live LRS integration and introduce peer code review as a formal assessed activity, not just an optional discussion prompt.</p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'View All Projects', href: '/projects' },
      { text: 'Get in Touch', href: '/contact' },
    ]}
  >
    <Fragment slot="title">Interested in working together?</Fragment>
    <Fragment slot="subtitle">I'm open to remote opportunities in instructional design and technical learning experience design.</Fragment>
  </CallToAction>
</Layout>
