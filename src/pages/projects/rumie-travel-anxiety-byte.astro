---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = {
  title: 'How I Dealt with Travel Anxiety — Rumie Microlearning Byte',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Microlearning Design · Rumie-Learn · Global OER · Peer Review">
    <Fragment slot="title">
      How I Dealt with Travel Anxiety —<br />
      <span class="text-accent dark:text-white">Microlearning Byte for Rumie-Learn</span>
    </Fragment>
    <Fragment slot="subtitle">
      A published microlearning Byte designed for Rumie-Learn — a free global learning library reaching learners across
      180+ countries. A 4-step, under-10-minute experience built around practical strategies for managing travel
      anxiety, written for a global mixed-literacy audience and refined through a structured two-tier peer review
      process.
    </Fragment>
  </Hero>

  <!-- Project Overview -->
  <Content tagline="The Project" title="Microlearning for a global, mixed-literacy audience" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12">
        <div class="text-center space-y-6">
          <div>
            <p class="text-7xl font-bold font-heading text-accent leading-none">4</p>
            <p class="text-xl text-muted mt-3">Steps · Under 10 Minutes</p>
          </div>
          <div class="mt-6 space-y-2 text-sm text-muted">
            <p class="font-semibold text-gray-700 dark:text-gray-300">Rumie-Learn · Open Educational Resource</p>
            <p>Global Distribution · 180+ Countries</p>
            <p>Two-Tier Peer Review · Published</p>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        Rumie is a nonprofit microlearning platform built on the belief that knowledge should be free and accessible to
        everyone. Bytes are short, focused learning experiences — under 10 minutes — distributed freely to learners
        worldwide, including those in low-connectivity environments.
      </p>
      <p class="mb-4">
        <em>How I Dealt with Travel Anxiety</em> was designed as a first-person, empathy-driven Byte for adult learners navigating
        travel-related stress. The topic was selected to reach a universally relatable knowledge gap — one that shows up
        across every audience demographic Rumie serves.
      </p>
      <p>
        The Byte passed through two editorial peer reviews and a final edit review before publication — a structured QA
        process that mirrors professional quality assurance workflows in corporate instructional design.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern-b"></div>
    </Fragment>
  </Content>

  <!-- Design Decisions -->
  <Features3
    tagline="Design Decisions"
    title="Four intentional choices behind the Byte"
    subtitle="Every structural and language decision was made with Rumie's global audience and microlearning constraints in mind."
    columns={2}
    items={[
      {
        title: 'Personal framing over prescriptive framing',
        description:
          'The title uses first-person ("I dealt with") rather than "How to manage travel anxiety" deliberately. A personal voice lowers the barrier to entry and signals lived experience — aligned with Rumie\'s "stickiness of social media" design philosophy.',
        icon: 'tabler:user',
      },
      {
        title: 'Cognitive load management through chunking',
        description:
          'Content was structured as discrete, single-concept steps — each advancing one idea before the next builds on it. Cognitive Load Theory informed the decision to avoid multi-concept slides even when it meant adding a step.',
        icon: 'tabler:brain',
      },
      {
        title: 'Application-based assessment over recall',
        description:
          'The knowledge check presents a realistic scenario — the night before a flight, anxiety already present, packing not started — rather than asking learners to define a term. The correct answer requires applying the content to a pressured real-world moment.',
        icon: 'tabler:checkbox',
      },
      {
        title: 'Global audience writing standard',
        description:
          'Language was kept simple and direct throughout — active voice, short sentences, no jargon. Rumie serves learners whose first language is not English; every editing pass asked whether a sentence could be shorter without losing meaning.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- Assessment Sample -->
  <div class="max-w-3xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">
        Assessment Design
      </p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Scenario-Based Knowledge Check</h2>
      <p class="text-lg text-muted mt-4 max-w-2xl mx-auto">
        Written to require application, not recall — the learner must use the Byte's content to navigate a realistic,
        pressured moment.
      </p>
    </div>
    <div
      class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm overflow-hidden"
    >
      <div class="bg-accent/10 dark:bg-accent/20 px-6 py-4 border-b border-gray-200 dark:border-gray-700">
        <p class="text-sm font-semibold text-accent uppercase tracking-wide">Quiz Question</p>
        <p class="text-sm text-muted mt-1">
          Creating a checklist can help reduce uncertainty and make travel feel more organized. Feeling prepared often
          helps lower anxiety before a trip.
        </p>
      </div>
      <div class="px-6 py-5">
        <p class="font-semibold text-gray-800 dark:text-gray-200 mb-5">
          It's the night before your flight and you realize you haven't started packing. You're already feeling anxious.
          What's the most helpful next step?
        </p>
        <div class="space-y-3">
          {
            [
              {
                letter: 'A',
                text: 'Start packing now and make a checklist of anything you still need to bring.',
                correct: true,
              },
              {
                letter: 'B',
                text: 'Call the airline to ask if you can change your flight to another day.',
                correct: false,
              },
              {
                letter: 'C',
                text: 'Decide to pack light and figure out what you need when you arrive.',
                correct: false,
              },
              {
                letter: 'D',
                text: "Go to bed and pack in the morning when you're feeling less stressed.",
                correct: false,
              },
            ].map(({ letter, text, correct }) => (
              <div
                class={`flex items-start gap-3 p-3 rounded-lg border ${correct ? 'border-green-300 dark:border-green-700 bg-green-50 dark:bg-green-900/20' : 'border-gray-200 dark:border-gray-700'}`}
              >
                <span
                  class={`flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-sm font-bold ${correct ? 'bg-green-500 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}
                >
                  {letter}
                </span>
                <p
                  class={`text-sm mt-0.5 ${correct ? 'text-green-800 dark:text-green-200 font-medium' : 'text-gray-600 dark:text-gray-400'}`}
                >
                  {text}
                </p>
              </div>
            ))
          }
        </div>
        <p class="text-xs text-muted mt-5 italic">
          Design note: This question was written as a scenario rather than a definition or recall prompt. The learner
          must apply the checklist strategy from the Byte's content to a realistic, pressured moment — meeting Rumie's
          standard that assessment require application, not memorization.
        </p>
      </div>
    </div>
  </div>

  <!-- Peer Review Process -->
  <Content tagline="Quality Assurance" title="A two-tier peer review process" isReversed>
    <Fragment slot="image">
      <div class="flex items-center justify-center h-full py-12 px-6">
        <div class="w-full max-w-xs space-y-3">
          {
            [
              {
                label: 'Tier 1 — Content & Structure',
                detail: 'Learning objective alignment, flow, effectiveness',
                color: 'blue',
              },
              {
                label: 'Tier 2 — Language & Format',
                detail: 'Clarity, grammar, visual consistency',
                color: 'green',
              },
              {
                label: 'Editorial Review 1',
                detail: 'Peer Learning Designer feedback via Rumie-Build',
                color: 'purple',
              },
              {
                label: 'Editorial Review 2 + Final',
                detail: 'Second pass + Squad Lead sign-off',
                color: 'orange',
              },
            ].map(({ label, detail, color }) => (
              <div
                class={`flex items-start gap-3 p-2.5 rounded-lg border ${color === 'blue' ? 'border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20' : color === 'green' ? 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20' : color === 'purple' ? 'border-purple-200 dark:border-purple-800 bg-purple-50 dark:bg-purple-900/20' : 'border-orange-200 dark:border-orange-800 bg-orange-50 dark:bg-orange-900/20'}`}
              >
                <div>
                  <p class="text-sm font-semibold text-gray-800 dark:text-gray-200">{label}</p>
                  <p class="text-xs text-muted mt-0.5">{detail}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <p class="mb-4">
        Rumie's peer review system is a structured two-tier feedback model that mirrors professional quality assurance
        workflows in corporate instructional design — including Quality Matters standards used in higher education.
      </p>
      <p class="mb-4">
        <strong>Tier 1</strong> focuses on content and structure: does the Byte fulfill its stated learning objective? Is
        the flow logical — big picture before supporting details? Does the assessment require application rather than simple
        recall?
      </p>
      <p class="mb-4">
        <strong>Tier 2</strong> addresses language and format: are sentences concise and direct? Is bold text used meaningfully?
        Do visuals complement rather than distract from the content?
      </p>
      <p>
        Feedback was managed across two platforms — ClickUp for overarching comments and Rumie-Build for step-specific
        annotations — a two-tool collaborative workflow that reflects industry-standard review practices.
      </p>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern"></div>
    </Fragment>
  </Content>

  <!-- Live Byte -->
  <div class="max-w-5xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <div class="text-center mb-10">
      <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">The Byte</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading">Published on Rumie-Learn</h2>
      <p class="text-lg text-muted mt-4">Free, globally distributed, under 10 minutes.</p>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a
        href="https://learn.rumie.org/jR/bytes/how-i-dealt-with-travel-anxiety-in-4-healthy-steps/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-semibold text-base hover:bg-accent/90 transition-colors shadow-sm"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
        Take the Byte on Rumie-Learn
      </a>
      <a
        href="/documents/how-i-dealt-with-travel-anxiety-in-4-healthy-steps.pdf"
        download
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-semibold text-base hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
        >
        Download PDF
      </a>
    </div>

    <!-- PDF embed -->
    <div class="rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden shadow-lg">
      <div
        class="bg-gray-100 dark:bg-gray-800 px-5 py-3 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between"
      >
        <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">How I Dealt with Travel Anxiety — Byte PDF</p>
        <a
          href="/documents/how-i-dealt-with-travel-anxiety-in-4-healthy-steps.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-accent hover:underline">Open in new tab</a
        >
      </div>
      <iframe
        src="/documents/how-i-dealt-with-travel-anxiety-in-4-healthy-steps.pdf"
        class="w-full"
        style="height: 700px;"
        title="How I Dealt with Travel Anxiety — Rumie Byte PDF"
     loading="lazy"></iframe>
    </div>
  </div>

  <!-- Skills Demonstrated -->
  <Features3
    tagline="What This Demonstrates"
    title="Skills evidenced by this project"
    columns={3}
    items={[
      {
        title: 'Microlearning Design',
        description: '4-step Byte under 10 minutes, single-concept chunking per step, progressive disclosure.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Cognitive Load Management',
        description: 'CLT-informed step structure — one concept per screen, no competing information.',
        icon: 'tabler:brain',
      },
      {
        title: 'Global Audience Writing',
        description: 'Plain language, active voice, no jargon — written for learners across 180+ countries.',
        icon: 'tabler:world',
      },
      {
        title: 'Application-Based Assessment',
        description: 'Scenario MC question requiring real-world application, not definition recall.',
        icon: 'tabler:checkbox',
      },
      {
        title: 'Collaborative QA Process',
        description: 'Two-tier peer review managed across ClickUp and Rumie-Build — mirrors QM workflow.',
        icon: 'tabler:git-pull-request',
      },
      {
        title: 'OER Contribution',
        description: 'Published free on Rumie-Learn — open educational resource, globally accessible.',
        icon: 'tabler:license',
      },
    ]}
  />

  <!-- Tags -->
  <div class="max-w-4xl mx-auto px-4 md:px-8 pb-16">
    <div class="flex flex-wrap gap-2">
      {
        [
          'Rumie-Learn',
          'Microlearning',
          'OER',
          'Peer Review',
          'Cognitive Load Theory',
          'Global Audience',
          'Plain Language',
          'Application-Based Assessment',
          'Instructional Design',
          'Quality Matters',
        ].map((tag) => (
          <span class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm font-medium px-3 py-1 rounded-full">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
</Layout>
