---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Projects',
};

const featured = [
  {
    icon: 'tabler:sparkles',
    title: 'Work Smarter with Gemini — Rise 360 Portfolio Course',
    description:
      'A self-paced Rise 360 course demonstrating modern AI tool integration for a large health organization — practical, learner-centered design built with Articulate Rise 360 after completing LearningMate training.',
    href: '/projects/gemini-rise-course',
    label: 'View Project',
  },
  {
    icon: 'tabler:brand-javascript',
    title: 'JavaScript & xAPI for eLearning',
    description:
      'A fully designed mini-course bridging JavaScript skills and xAPI for eLearning professionals — capstone for a Graduate Certificate in Learning Design & Technology, covering SCORM alternatives and statement design.',
    href: '/projects/javascript-xapi-elearning',
    label: 'View Case Study',
  },
  {
    icon: 'tabler:puzzle',
    title: 'Chrome Extension — Udacity Career Materials Reviewer',
    description:
      'A custom-built Chrome extension that cut career materials review time by 80% — from one hour to twelve minutes — by automating repetitive form entry. Built in response to a real workflow bottleneck at Udacity.',
    href: '/projects/chrome-extension-udacity',
    label: 'View Case Study',
  },
];
---

<Layout metadata={metadata}>
  <Hero tagline="Portfolio">
    <Fragment slot="title"> Selected Work </Fragment>
    <Fragment slot="subtitle">
      A collection of instructional design, eLearning development, live instruction, and speaking engagements spanning
      graduate coursework, professional practice, and independent development.
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a
          href="#instructional-design"
          class="inline-block border border-gray-400 dark:border-gray-500 text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent dark:hover:text-accent text-sm font-medium px-4 py-2 rounded-full transition-colors duration-200"
          >Instructional Design & eLearning</a
        >
        <a
          href="#live-instruction"
          class="inline-block border border-gray-400 dark:border-gray-500 text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent dark:hover:text-accent text-sm font-medium px-4 py-2 rounded-full transition-colors duration-200"
          >Live Instruction — Masterschool</a
        >
        <a
          href="#teaching"
          class="inline-block border border-gray-400 dark:border-gray-500 text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent dark:hover:text-accent text-sm font-medium px-4 py-2 rounded-full transition-colors duration-200"
          >Teaching & Instruction</a
        >
        <a
          href="#speaking"
          class="inline-block border border-gray-400 dark:border-gray-500 text-gray-700 dark:text-gray-300 hover:border-accent hover:text-accent dark:hover:text-accent text-sm font-medium px-4 py-2 rounded-full transition-colors duration-200"
          >Speaking & Guest Expertise</a
        >
      </div>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern"></div>
    </Fragment>
  </Hero>

  <!-- Sticky section nav — appears after hero scrolls away -->
  <div
    id="section-nav"
    class="fixed left-0 right-0 z-30 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm border-b border-gray-200 dark:border-gray-700 opacity-0 pointer-events-none transition-opacity duration-300"
    style="top: 0px"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-wrap gap-2 justify-center">
      <a
        data-section="instructional-design"
        href="#instructional-design"
        class="section-spy-btn inline-block border border-gray-400 dark:border-gray-500 text-gray-600 dark:text-gray-400 text-xs font-medium px-3 py-1 rounded-full transition-colors duration-200"
        >Instructional Design & eLearning</a
      >
      <a
        data-section="live-instruction"
        href="#live-instruction"
        class="section-spy-btn inline-block border border-gray-400 dark:border-gray-500 text-gray-600 dark:text-gray-400 text-xs font-medium px-3 py-1 rounded-full transition-colors duration-200"
        >Live Instruction — Masterschool</a
      >
      <a
        data-section="teaching"
        href="#teaching"
        class="section-spy-btn inline-block border border-gray-400 dark:border-gray-500 text-gray-600 dark:text-gray-400 text-xs font-medium px-3 py-1 rounded-full transition-colors duration-200"
        >Teaching & Instruction</a
      >
      <a
        data-section="speaking"
        href="#speaking"
        class="section-spy-btn inline-block border border-gray-400 dark:border-gray-500 text-gray-600 dark:text-gray-400 text-xs font-medium px-3 py-1 rounded-full transition-colors duration-200"
        >Speaking & Guest Expertise</a
