  <script>
    function initScrollspy() {
      const stickyNav = document.getElementById('section-nav') as HTMLElement | null;
      const sectionIds = ['instructional-design', 'live-instruction', 'teaching', 'speaking'];
      const heroThreshold = 320;

      // Position below the sticky header (including the progress bar at its bottom)
      const header = document.querySelector('[data-aw-sticky-header]') as HTMLElement | null;
      if (stickyNav && header) {
        const headerBottom = header.getBoundingClientRect().bottom;
        stickyNav.style.top = `${headerBottom}px`;
      }

      function getActiveSection() {
        let current = sectionIds[0];
        for (const id of sectionIds) {
          const el = document.getElementById(id);
          if (el && el.getBoundingClientRect().top <= 90) current = id;
        }
        return current;
      }

      function updateNav() {
        if (!stickyNav) return;
        const scrolled = window.scrollY > heroThreshold;
        stickyNav.classList.toggle('opacity-0', !scrolled);
        stickyNav.classList.toggle('pointer-events-none', !scrolled);

        const active = getActiveSection();
        document.querySelectorAll('.section-spy-btn').forEach((btn) => {
          const el = btn as HTMLElement;
          const isActive = el.getAttribute('data-section') === active;
          if (isActive) {
            el.style.background = 'linear-gradient(135deg, #7c3aed, #5e18eb)';
            el.style.borderColor = 'transparent';
            el.classList.add('text-white');
            el.classList.remove('text-gray-600', 'dark:text-gray-400', 'border-gray-400', 'dark:border-gray-500');
          } else {
            el.style.background = '';
            el.style.borderColor = '';
            el.classList.remove('text-white');
            el.classList.add('text-gray-600', 'dark:text-gray-400', 'border-gray-400', 'dark:border-gray-500');
          }
        });
      }

      window.addEventListener('scroll', updateNav, { passive: true });
      updateNav();
    }

    document.addEventListener('astro:page-load', initScrollspy);
  </script>
</Layout>
