---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';

const metadata = {
  title: 'Projects',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Portfolio">
    <Fragment slot="title">
      Selected Work
    </Fragment>
    <Fragment slot="subtitle">
      A collection of instructional design, eLearning development, technical learning projects, and speaking engagements spanning graduate coursework, professional practice, and independent development.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 section-pattern"></div>
    </Fragment>
  </Hero>

  <Features2
    title="Instructional Design"
    columns={2}
    items={[
      {
        title: 'Work Smarter with Gemini: A Practical Guide for Business Teams',
        description: 'A self-paced Rise 360 eLearning course designed to help business teams get practical value from Google Gemini — covering AI fundamentals, prompt writing, daily workflow integration, and building custom Gemini Gems for recurring tasks.',
        icon: 'tabler:sparkles',
        callToAction: { text: 'View Project', href: '/projects/gemini-rise-course' },
      },
      {
        title: 'ChatGPT as an AI-Powered Learning Tool',
        description: 'A research-backed evaluation and 3-phase implementation strategy for integrating ChatGPT into technical SaaS customer education — including a practical AI Tool Guide for learning designers. UMGC LDTC 620: Next Generation Design — Emerging Technology, Gamification, and AI in Learning Design.',
        icon: 'tabler:robot',
        callToAction: { text: 'View Case Study', href: '/projects/ldtc620-chatgpt-ai-tool' },
      },
      {
        title: 'Social & Collaborative Learning Spaces',
        description: 'An applied analysis of Bandura\'s Social Learning Theory across GitHub, Slack, Discord, AI coding tools, LinkedIn Learning, and YouTube — examining how each platform activates the conditions adult learners need to observe, retain, and reproduce new technical skills. UMGC LDTC 620.',
        icon: 'tabler:users',
        callToAction: { text: 'View Case Study', href: '/projects/ldtc620-social-learning-tech' },
      },
      {
        title: 'JavaScript & xAPI for eLearning',
        description: 'A fully designed mini-course bridging the gap between JavaScript skills and xAPI understanding for eLearning professionals. Developed as the capstone for a Graduate Certificate in Learning Design & Technology.',
        icon: 'tabler:brand-javascript',
        callToAction: { text: 'View Case Study', href: '/projects/javascript-xapi-elearning' },
      },
      {
        title: 'Epic React Step-by-Step Guides — Masterschool',
        description: 'Recorded a series of Loom screencast walkthroughs for Masterschool students onboarding to Epic React — covering account verification, login, and navigating the lesson environment to remove friction before the first lesson.',
        icon: 'tabler:video',
        callToAction: { text: 'View Case Study', href: '/projects/masterschool-epic-react' },
      },
      {
        title: 'Peer to Peer: Pair Programming with Epic React — Masterschool',
        description: 'A live presentation delivered to Masterschool students introducing pair programming as a structured learning strategy — covering the driver/navigator model, productive struggle, and how to collaborate effectively in the Epic React Testing Workshop.',
        icon: 'tabler:users',
        callToAction: { text: 'View Case Study', href: '/projects/masterschool-pair-programming' },
      },
      {
        title: 'UdaciRacer Project Walkthrough — Masterschool',
        description: 'A live project walkthrough and Q&A session for Masterschool students on the UdaciRacer JavaScript racing game — covering async programming, the Fetch API, DOM manipulation, and working with a Node.js server.',
        icon: 'tabler:rocket',
        callToAction: { text: 'View Case Study', href: '/projects/masterschool-udaciracer' },
      },
      {
        title: 'Personal Blog Project Walkthrough — Masterschool',
        description: 'A live project walkthrough and Q&A session for Masterschool students on the Udacity Personal Blog project — covering CSS architecture, mobile-first responsive design, CSS Grid, and Flexbox with real-time student questions throughout.',
        icon: 'tabler:layout-columns',
        callToAction: { text: 'View Case Study', href: '/projects/masterschool-personal-blog' },
      },
      {
        title: 'Build a Shopping Cart — Masterschool Project Walkthrough',
        description: 'A step-by-step Loom screencast walkthrough for Masterschool students working through the Build a Shopping Cart project on the Udacity platform — guiding them from project setup through to completion.',
        icon: 'tabler:shopping-cart',
        callToAction: { text: 'View Case Study', href: '/projects/masterschool-shopping-cart' },
      },
      {
        title: 'Chrome Extension — Udacity Career Materials Reviewer',
        description: 'A custom-built Chrome extension that reduced average career materials review time by 80% — from one hour to twenty minutes — by automating repetitive form entry at Udacity.',
        icon: 'tabler:puzzle',
        callToAction: { text: 'View Case Study', href: '/projects/chrome-extension-udacity' },
      },
      {
        title: 'Learning Technology Infographic',
        description: 'A visual synthesis of learning technology frameworks — SAMR, the Hype Cycle, and Articulate Rise 360 — designed in Canva as the Unit 1 assignment for LDTC 620: Next Generation Design — Emerging Technology, Gamification, and AI in Learning Design at UMGC.',
        icon: 'tabler:layout',
        callToAction: { text: 'View Project', href: '/projects/ldtc620-infographic' },
      },
    ]}
  />

  <Features2
    title="Teaching & Instruction"
    columns={2}
    items={[
      {
        title: 'Web Development Bootcamp — University of Washington',
        description: 'In-person classroom instruction for the UW web development bootcamp via Trilogy Education — teaching HTML, CSS, and JavaScript to career-changers through live coding and Chrome DevTools demos.',
        icon: 'tabler:school',
        callToAction: { text: 'View Case Study', href: '/projects/uw-trilogy-bootcamp' },
      },
      {
        title: 'Technical Expert — Chegg Skills (Thinkful)',
        description: 'One-on-one technical support sessions for career-changing students in Thinkful\'s Engineering Immersion prep program — reviewing GitHub submissions, writing graded feedback, and live code walkthroughs via Zoom.',
        icon: 'tabler:headset',
        callToAction: { text: 'View Case Study', href: '/projects/chegg-technical-expert' },
      },
      {
        title: 'Career & Technical Instructor — Udacity & OneTen Scholarship',
        description: 'Group instruction sessions for a cohort of OneTen scholarship students enrolled in Udacity\'s Front End Web Development Nanodegree — live CSS Grid walkthroughs, Q&A facilitation, and study strategy coaching.',
        icon: 'tabler:school',
        callToAction: { text: 'View Case Study', href: '/projects/udacity-oneten-scholarship' },
      },
    ]}
  />

  <Features2
    title="Speaking & Guest Expertise"
    columns={2}
    items={[
      {
        title: 'Work with Clients\' Needs — OpenClassrooms Open Study',
        description: 'Facilitated a live Open Study group session reviewing student WordPress deliverables for a client-facing project milestone — guiding live feedback on theme choices, design rationale, and client alignment.',
        icon: 'tabler:users',
        callToAction: { text: 'View Case Study', href: '/projects/oc-work-with-clients' },
      },
      {
        title: 'CSS and SASS Student Webinar — OpenClassrooms',
        description: 'Live student webinar covering CSS architecture, the BEM naming convention, the 7-1 SASS pattern, and core SASS features — delivered to a global OpenClassrooms audience in September 2020.',
        icon: 'tabler:brand-css3',
        callToAction: { text: 'View Case Study', href: '/projects/css-sass-webinar' },
      },
      {
        title: 'Modern Animations with SCSS/SASS — OpenClassrooms',
        description: 'Live student webinar on building modern animations using SCSS/SASS — covering transitions, @keyframes, the 12 principles of animation applied to the web, and Chrome DevTools profiling — December 2020.',
        icon: 'tabler:keyframes',
        callToAction: { text: 'View Case Study', href: '/projects/css-animations-webinar' },
      },
      {
        title: 'Mentoring Students with Disabilities',
        description: 'Invited as a guest speaker for an OpenClassrooms internal webinar, sharing practical strategies and case studies from direct experience mentoring web development students with learning disabilities.',
        icon: 'tabler:microphone',
        callToAction: { text: 'View Project', href: '/projects/mentoring-students-disabilities' },
      },
    ]}
  />
</Layout>
