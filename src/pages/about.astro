---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import profileImage from '~/assets/images/profile.jpeg';

const metadata = {
  title: 'Jonathan Root — Technical Learning Experience Designer',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      { variant: 'primary', text: 'View My Work', href: '/projects' },
      { text: 'Get in Touch', href: '/about#contact' },
    ]}
  >
    <Fragment slot="title">
      Jonathan Root
    </Fragment>
    <Fragment slot="subtitle">
      Technical Learning Experience Designer with over eight years of experience building scalable learning for software developers. I work at the intersection of instructional design, web development, and digital learning.
    </Fragment>
  </Hero>

  <!-- Bio with image background -->
  <div class="relative w-full">
    <img src={profileImage.src} alt="Jonathan Root" class="w-full h-auto block" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="w-full md:w-1/2 px-8 md:px-16 text-white">
        <h2 class="text-2xl md:text-3xl font-bold font-heading mb-4">A rare combination of technical fluency and instructional design expertise</h2>
        <p class="text-base md:text-lg mb-4 text-gray-200">My background spans curriculum development, eLearning production, SME collaboration, and front-end web development — with eight years of experience working with organizations including Udacity, Springboard, OpenClassrooms, TCCC, UW, Boeing, Chegg Skills, LearningMate, and Masterschool.</p>
        <p class="text-base md:text-lg text-gray-200">In my current role at LearningMate I collaborate with instructional designers and project managers to create learning content for web development programs — developing storyboards, assessments, AI-driven learning activities, and Articulate Rise 360 modules aligned to learning objectives and learner personas.</p>
      </div>
    </div>
  </div>

  <!-- What I Do -->
  <Content
    tagline="What I Do"
    title="At the intersection of design, technology, and learning"
    items={[
      {
        title: 'Instructional Design',
        description: 'Designing structured, outcome-driven learning experiences grounded in established frameworks like ADDIE, SAM, and constructivist learning theory.',
      },
      {
        title: 'eLearning Development',
        description: 'Building interactive courses in Articulate Storyline and Rise 360, extended with custom JavaScript for dynamic behavior and xAPI for rich data tracking.',
      },
      {
        title: 'Technical Learning Content',
        description: 'Translating complex technical systems — APIs, developer tools, software workflows — into clear, engaging content for technical and non-technical audiences alike.',
      },
    ]}
  >
    <Fragment slot="content">
      I work at the intersection of instructional design, web development, and digital learning — translating complex technical systems into clear, engaging, and interactive learning experiences for developers, learners, and users.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Areas of Expertise -->
  <Features3
    title="Areas of Expertise"
    subtitle="A cross-disciplinary skill set spanning design, development, and learning science."
    columns={3}
    items={[
      {
        title: 'Curriculum & Course Design',
        description: 'Learning objectives, assessment alignment, and course architecture from concept through delivery.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'JavaScript for eLearning',
        description: 'Custom interactions, DOM manipulation, and dynamic content within authoring tools and HTML-based modules.',
        icon: 'tabler:brand-javascript',
      },
      {
        title: 'xAPI & Learning Analytics',
        description: 'Designing and implementing xAPI statements to capture rich learner behavior data beyond basic completion metrics.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Articulate Storyline & Rise',
        description: 'Building polished, accessible eLearning modules with advanced interactions and branching scenarios.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Web Development',
        description: 'HTML, CSS, and JavaScript for custom learning tools, portfolio sites, and browser-based educational applications.',
        icon: 'tabler:code',
      },
      {
        title: 'Accessibility & Inclusive Design',
        description: 'Applying WCAG standards and Universal Design for Learning principles across all instructional materials.',
        icon: 'tabler:accessible',
      },
    ]}
  />

  <!-- Organizations -->
  <Features3
    tagline="Experience"
    title="Organizations I've Worked With"
    subtitle="Eight years across EdTech, enterprise training, and higher education."
    columns={3}
    items={[
      { title: 'Udacity', description: 'Developer education and career programs at scale.', icon: 'tabler:school' },
      { title: 'Springboard', description: 'Curriculum and mentorship for tech career transitions.', icon: 'tabler:school' },
      { title: 'OpenClassrooms', description: 'Online degree programs and technical learning paths.', icon: 'tabler:school' },
      { title: 'Boeing', description: 'Enterprise technical training and compliance learning.', icon: 'tabler:school' },
      { title: 'Chegg Skills', description: 'Skills-based learning for career readiness.', icon: 'tabler:school' },
      { title: 'LearningMate', description: 'Web development learning content and Rise 360 production.', icon: 'tabler:school' },
    ]}
  />

  <!-- Education -->
  <Steps2
    tagline="Education"
    title="Academic Background"
    items={[
      {
        title: 'M.S. Learning Design and Technology',
        description: 'University of Maryland Global Campus (UMGC) — In progress.',
      },
      {
        title: 'Graduate Certificate in Learning Design and Technology',
        description: 'University of Maryland Global Campus (UMGC) — Completed.',
      },
    ]}
  />

  <!-- Contact -->
  <div id="contact" class="max-w-3xl mx-auto px-4 md:px-8 py-16 md:py-24 text-center">
    <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2">Contact</p>
    <h2 class="text-4xl md:text-5xl font-bold tracking-tighter font-heading mb-6">Let's Connect</h2>
    <p class="text-xl text-muted mb-4">
      I'm actively looking for remote roles in technical instructional design, developer education, customer education, and product training at SaaS and EdTech companies.
    </p>
    <p class="text-lg text-muted mb-10">
      The best way to reach me is on LinkedIn. I typically respond within one business day.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="https://www.linkedin.com/in/jonathanroot/"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent/90 text-white font-semibold px-8 py-4 rounded-lg transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        Connect on LinkedIn
      </a>
      <a
        href="https://github.com/jaroot32"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 border-2 border-current text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 font-semibold px-8 py-4 rounded-lg transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        View GitHub
      </a>
    </div>
  </div>
</Layout>
